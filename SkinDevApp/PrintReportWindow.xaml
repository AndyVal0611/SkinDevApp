<Window x:Class="SkinDevApp.Views.PrintReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMYVUE - Clinical Print Preview" Height="850" Width="680"
        WindowStartupLocation="CenterScreen" Background="#EAEAEA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PagesPanel">
            <Border x:Name="PrintCanvas" Width="595" Height="842" Background="White" Padding="35,40,35,35" CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.1" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header & System Title -->
                        <RowDefinition Height="Auto"/>
                        <!-- Research Team -->
                        <RowDefinition Height="Auto"/>
                        <!-- Patient Information Block -->
                        <RowDefinition Height="Auto"/>
                        <!-- Image & Status Grid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Recommendations -->
                        <RowDefinition Height="*"/>
                        <!-- Disclaimer & Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header Section with Proper Spacing (No Overlap) -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock Text="LUMYVUE" FontSize="26" FontWeight="Bold" Foreground="#1A2328" VerticalAlignment="Bottom"/>
                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ReportDateTxt" Text="Date: 2026-09-04 16:07" FontSize="10" Foreground="#555555" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="RefIdTxt" Text="Ref ID: #LUM-8842" FontSize="10" FontWeight="Bold" Foreground="#1A2328" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- Subtitle with clean top margin so it won't dikit -->
                        <TextBlock Text="Aesthetic Skin Evaluation &amp; Diagnostic Summary" FontSize="11" Foreground="#8A827A" FontWeight="SemiBold" Margin="0,6,0,8"/>
                        <!-- Horizontal Rule Line -->
                        <Border Height="2" Background="#1A2328" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- System Developers / Research Team -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15" HorizontalAlignment="Center">
                        <TextBlock Text="SYSTEM DEVELOPERS / RESEARCH TEAM" FontSize="10" FontWeight="Bold" Foreground="#1A2328" HorizontalAlignment="Center"/>
                        <TextBlock Text="Elaiza Czanna Claire C. Bautista | Francesca Nicolette S. Pineda | Andrea M. Valdez" 
                                   FontSize="9" Foreground="#555555" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Patient Information Section Block (Linked to Registration Data) -->
                    <Border Grid.Row="2" Background="#FBF9F6" CornerRadius="8" Padding="15,12" Margin="0,0,0,15" BorderBrush="#E2EADF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="PATIENT / CLIENT NAME" FontSize="9" FontWeight="Bold" Foreground="#8A827A"/>
                                <TextBlock x:Name="PatientNameTxt" Text="Client Walk-In" FontSize="12" FontWeight="Bold" Foreground="#1A2328"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock Text="PATIENT DETAILS (AGE / CONTACT)" FontSize="9" FontWeight="Bold" Foreground="#8A827A"/>
                                <TextBlock x:Name="PatientDetailsTxt" Text="Age: N/A | Contact: N/A" FontSize="11" FontWeight="SemiBold" Foreground="#1A2328"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="CONSULTATION DATE" FontSize="9" FontWeight="Bold" Foreground="#8A827A"/>
                                <TextBlock x:Name="ConsultationDateTxt" Text="2026-09-04" FontSize="12" FontWeight="Bold" Foreground="#1A2328"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Captured Visual Image & Diagnostic Status Grid -->
                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Captured Face Image with Centered Crop Match -->
                        <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True" Height="220" BorderBrush="#D1D5DB" BorderThickness="1">
                            <Image x:Name="ReportFaceImage" 
                                   Stretch="UniformToFill" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </Border>

                        <!-- Dermatological Status Metrics & Primary Diagnosis -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Dermatological Status" FontSize="14" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,10"/>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Acne" FontSize="11" FontWeight="SemiBold" Foreground="#1A2328"/>
                                <TextBlock x:Name="AcnePercentTxt" Text="65.0%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="AcneProgress" Value="65" Height="7" Background="#EAEAEA" Foreground="#E0B0A2" Margin="0,0,0,8" BorderThickness="0"/>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Hyperpigmentation" FontSize="11" FontWeight="SemiBold" Foreground="#1A2328"/>
                                <TextBlock x:Name="HyperPercentTxt" Text="5.0%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="HyperProgress" Value="5" Height="7" Background="#EAEAEA" Foreground="#D4A373" Margin="0,0,0,8" BorderThickness="0"/>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Eczema" FontSize="11" FontWeight="SemiBold" Foreground="#1A2328"/>
                                <TextBlock x:Name="EczemaPercentTxt" Text="7.0%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="EczemaProgress" Value="7" Height="7" Background="#EAEAEA" Foreground="#CCD5AE" Margin="0,0,0,8" BorderThickness="0"/>

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Normal" FontSize="11" FontWeight="SemiBold" Foreground="#1A2328"/>
                                <TextBlock x:Name="NormalPercentTxt" Text="23.0%" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="NormalProgress" Value="23" Height="7" Background="#EAEAEA" Foreground="#588157" Margin="0,0,0,14" BorderThickness="0"/>

                            <Border Background="#1A2328" CornerRadius="8" Padding="12,10">
                                <TextBlock x:Name="PrimaryStatusTxt" Text="Primary Status: Acne (65.0% Confidence)" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Recommendations Section -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <TextBlock Text="Recommended Next Steps:" FontSize="12" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,4"/>
                        <TextBlock Text="• Schedule targeted skincare consultation with accredited clinic specialists." FontSize="10" Foreground="#555555" Margin="0,0,0,2"/>
                        <TextBlock Text="• Maintain daily gentle hydration regime and sun protection." FontSize="10" Foreground="#555555"/>
                    </StackPanel>

                    <!-- Disclaimer & Footer -->
                    <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                        <Border Height="1" Background="#E2EADF" Margin="0,0,0,10"/>
                        <TextBlock Text="DISCLAIMER" FontSize="9" FontWeight="Bold" Foreground="#1A2328" HorizontalAlignment="Center"/>
                        <TextBlock Text="This report is generated through an AI-assisted system and is intended for preliminary screening purposes only. It must not replace professional medical diagnosis, consultation, or treatment by licensed healthcare providers." 
                                   FontSize="8" Foreground="#777777" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,10"/>

                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="LUMYVUE Kiosk Interactive System | Confidential" FontSize="8" Foreground="#999999" VerticalAlignment="Bottom"/>
                            <StackPanel HorizontalAlignment="Right">
                                <Border Width="120" Height="1" Background="#1A2328" Margin="0,0,0,2"/>
                                <TextBlock Text="Authorized Medical Personnel" FontSize="8" FontWeight="SemiBold" Foreground="#1A2328" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="TriggerPrintBtn" Grid.Row="1" Content="🖨️ CONFIRM &amp; PRINT PDF REPORT" Height="45" Width="260" 
                Background="#1A2328" Foreground="White" FontWeight="Bold" FontSize="12" 
                BorderThickness="0" Margin="0,15,0,0" HorizontalAlignment="Center" Click="TriggerPrintBtn_Click"/>
    </Grid>
</Window>