<Page x:Class="SkinDevApp.Views.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Registration" Background="Transparent">

    <Page.Resources>
        <!-- Every form row uses equal columns with a 16 px gutter. The row is pulled 16 px to the right and every cell gives
             16 px back, so all fields line up with the card's right edge and with the rows above and below. -->
        <Style x:Key="Row" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,-16,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="Req" TargetType="Run">
            <Setter Property="Foreground" Value="#B4483F"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3EFE6"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="IfField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EDE8DC"/>
                    <Setter Property="BorderBrush" Value="#E3DCCB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IfArea" TargetType="TextBox" BasedOn="{StaticResource FieldArea}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EDE8DC"/>
                    <Setter Property="BorderBrush" Value="#E3DCCB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#EEE8DA"/>
            <Setter Property="Margin" Value="0,20,0,4"/>
        </Style>
        <!-- check lists: one tick per line, wrapping long answers -->
        <Style x:Key="Tick" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,1,16,1"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <StackPanel Grid.Row="1" Margin="8,0,8,10">
            <TextBlock x:Name="PageTitle" Text="Patient registration" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0">
                Fields marked <Run Text="*" Style="{StaticResource Req}"/> are required. The participant signs the separate paper consent form; no signature is collected on screen.
                Photographs are filed under the Patient ID, never under the name.
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="SplitGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="262"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ section list: jump to a section, see which ones are complete ============ -->
            <Border x:Name="NavCard" Style="{StaticResource Card}" Padding="14,18" VerticalAlignment="Top">
                <StackPanel x:Name="NavPanel"/>
            </Border>

            <ScrollViewer x:Name="FormScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" ScrollChanged="FormScroll_ScrollChanged">
                <StackPanel x:Name="FormStack">

                    <Border x:Name="LegacyNote" Style="{StaticResource NoticeBox}" Margin="8,8,8,4" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Body}" Foreground="#6B4438">
                            <Run FontWeight="SemiBold" Text="Registered with the earlier form."/>
                            <Run Text="The skin-profile answers from that form are kept unchanged and still appear in the patient record. The medical history below was not collected then, so fill in what is available. For this patient only the record details, age and gender are required."/>
                        </TextBlock>
                    </Border>

                    <!-- ===================================================== 1. registration record -->
                    <Border x:Name="SecRecord" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Patient ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PatientIdTxt" Style="{StaticResource ReadOnlyField}" Background="#EFD7CF" FontWeight="Bold"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Created automatically. It cannot be changed."/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Registration date" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RegDateTxt" Style="{StaticResource ReadOnlyField}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Recorded by (staff ID) <Run x:Name="OperatorReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="OperatorTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource Cell}">
                                        <TextBlock Text="Record status" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="StatusCombo" Style="{StaticResource Combo}">
                                            <ComboBoxItem Content="Active"/>
                                            <ComboBoxItem Content="Withdrawn"/>
                                            <ComboBoxItem Content="Completed"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                        <TextBlock Style="{StaticResource FieldLabel}">Reason for this change <Run Text="*" Style="{StaticResource Req}"/></TextBlock>
                                        <TextBox x:Name="EditReasonTxt" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Changing the registration never alters saved scan results. The change is written to the audit log."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 2. patient information -->
                    <Border x:Name="SecPatient" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Legal first name <Run x:Name="FirstNameReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="FirstNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Middle name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MiddleNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Legal last name <Run x:Name="LastNameReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="LastNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Date of birth <Run x:Name="DobReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <DatePicker x:Name="DobPicker" SelectedDateChanged="DobPicker_Changed"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="MM/DD/YYYY, or pick the date from the calendar."/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock x:Name="AgeLabel" Text="Age (calculated)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AgeTxt" Style="{StaticResource ReadOnlyField}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Gender <Run Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <ComboBox x:Name="SexCombo" Style="{StaticResource Combo}">
                                        <ComboBoxItem Content="Male"/>
                                        <ComboBoxItem Content="Female"/>
                                        <ComboBoxItem Content="Intersex"/>
                                        <ComboBoxItem Content="Prefer not to say"/>
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Marital status" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="MaritalCombo" Style="{StaticResource Combo}">
                                        <ComboBoxItem Content="Single"/>
                                        <ComboBoxItem Content="Married"/>
                                        <ComboBoxItem Content="Living with a partner"/>
                                        <ComboBoxItem Content="Separated"/>
                                        <ComboBoxItem Content="Divorced"/>
                                        <ComboBoxItem Content="Widowed"/>
                                        <ComboBoxItem Content="Prefer not to say"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Occupation" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="OccupationTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 3. contact details -->
                    <Border x:Name="SecContact" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Mailing address (street, city, province or state, ZIP code)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AddressTxt" Style="{StaticResource Field}"/>

                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="E-mail address" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EmailTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Home phone <Run x:Name="HomePhoneReq" Text="†" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="HomePhoneTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Cell phone <Run x:Name="CellPhoneReq" Text="†" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="CellPhoneTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="PhoneHint" Style="{StaticResource Hint}" HorizontalAlignment="Right">
                                <Run Text="†" Style="{StaticResource Req}"/> At least one phone number is required.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 4. referral and primary care -->
                    <Border x:Name="SecReferral" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Referred to the clinic by" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel x:Name="ReferralPanel">
                                <RadioButton Content="Doctor" GroupName="Referral" Style="{StaticResource Choice}"/>
                                <RadioButton Content="Family / friend" GroupName="Referral" Style="{StaticResource Choice}"/>
                                <RadioButton Content="Insurance company" GroupName="Referral" Style="{StaticResource Choice}"/>
                                <RadioButton Content="Web search" GroupName="Referral" Style="{StaticResource Choice}"/>
                                <RadioButton Content="Print ad" GroupName="Referral" Style="{StaticResource Choice}"/>
                                <RadioButton Content="Other" GroupName="Referral" Style="{StaticResource Choice}"/>
                            </WrapPanel>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock x:Name="ReferralDetailLabel" Text="Referral details" Style="{StaticResource FieldLabel}" Margin="0,4,0,5"/>
                                    <TextBox x:Name="ReferralDetailTxt" Style="{StaticResource IfField}" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Primary care physician (PCP) name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PcpNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="PCP phone (if known)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PcpPhoneTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 5. emergency contact -->
                    <Border x:Name="SecEmergency" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EmergencyNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Relationship to patient" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EmergencyRelationTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Phone number" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EmergencyPhoneTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 6. reason for visit -->
                    <Border x:Name="SecVisit" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}">Reason for visit <Run x:Name="VisitReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                            <TextBox x:Name="VisitReasonTxt" Style="{StaticResource FieldArea}"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Location of the problem" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LocationTxt" Style="{StaticResource Field}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="For example: both cheeks and the forehead."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Duration of the problem" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="DurationTxt" Style="{StaticResource Field}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="For example: 3 months."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 7. medical history -->
                    <Border x:Name="SecHistory" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}">Past medical history <Run x:Name="PmhReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Tick all that apply. If none apply, tick None."/>
                            <UniformGrid x:Name="PmhPanel" Columns="3" Style="{StaticResource Row}">
                                <StackPanel>
                                    <CheckBox Content="Allergies (seasonal)" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Asthma" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Bleeding disorder (or bleeding issue)" Style="{StaticResource Tick}"/>
                                    <CheckBox x:Name="CancerChk" Content="Cancer" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Coronary artery bypass" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Depression" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Diabetes" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Fever blister" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Heart valve replacement" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="High blood pressure" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="High cholesterol" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="HIV/AIDS" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Joint replacement" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Kidney transplant" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Liver disease" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Lumpectomy" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Lupus / rheumatoid arthritis" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Mastectomy" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Organ transplant" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Thyroid disease" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="None" Tag="None" Style="{StaticResource Tick}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Type of cancer (if ticked)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CancerTxt" Style="{StaticResource IfField}" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Divider}"/>

                            <TextBlock Style="{StaticResource FieldLabel}">History of skin cancer or skin disorders? <Run x:Name="SkinHxReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="For example: acne, actinic keratosis, basal cell carcinoma, melanoma, psoriasis, squamous cell carcinoma."/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,16,0">
                                    <RadioButton x:Name="SkinHxYes" Content="Yes" GroupName="SkinHx" Style="{StaticResource Choice}"/>
                                    <RadioButton x:Name="SkinHxNo" Content="No" GroupName="SkinHx" Style="{StaticResource Choice}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBox x:Name="SkinHxTxt" Style="{StaticResource IfField}" IsEnabled="False"
                                             ToolTip="If yes, the condition or disorder"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="If yes, name the condition or disorder."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 8. medications and allergies -->
                    <Border x:Name="SecMeds" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="2" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Current medications <Run x:Name="MedsReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Include non-prescription medicines and birth control."/>
                                    <TextBox x:Name="MedsTxt" Style="{StaticResource IfArea}"/>
                                    <CheckBox x:Name="MedsNaChk" Content="None (N/A)" Style="{StaticResource Tick}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Allergies <Run x:Name="AllergiesReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Include allergies to medicines."/>
                                    <TextBox x:Name="AllergiesTxt" Style="{StaticResource IfArea}"/>
                                    <CheckBox x:Name="AllergiesNaChk" Content="None (N/A)" Style="{StaticResource Tick}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 9. social history and review of systems -->
                    <Border x:Name="SecSocial" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Do you smoke? <Run x:Name="SmokeReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SmokeYes" Content="Yes" GroupName="Smoke" Style="{StaticResource Choice}"/>
                                        <RadioButton x:Name="SmokeNo" Content="No" GroupName="Smoke" Style="{StaticResource Choice}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="If yes, how much?" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SmokeAmountTxt" Style="{StaticResource IfField}" IsEnabled="False"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Do you drink alcohol? <Run x:Name="AlcoholReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="AlcoholYes" Content="Yes" GroupName="Alcohol" Style="{StaticResource Choice}"/>
                                        <RadioButton x:Name="AlcoholNo" Content="No" GroupName="Alcohol" Style="{StaticResource Choice}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="If yes, how much?" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AlcoholAmountTxt" Style="{StaticResource IfField}" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Divider}"/>

                            <TextBlock Text="Review of systems" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Tick all that apply."/>
                            <UniformGrid x:Name="RosPanel" Columns="3" Style="{StaticResource Row}">
                                <StackPanel>
                                    <CheckBox Content="Problems with bleeding" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Problems with healing" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Problems with scarring or keloids" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Fever or chills" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Night sweats" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Unintentional weight loss" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Joint pain" Style="{StaticResource Tick}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 10. alerts -->
                    <Border x:Name="SecAlerts" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}">Alerts <Run x:Name="AlertsReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Tick all that apply. If none apply, tick None."/>
                            <UniformGrid x:Name="AlertsPanel" Columns="3" Style="{StaticResource Row}">
                                <StackPanel>
                                    <CheckBox Content="Allergy to adhesive" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Allergy to lidocaine" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Allergy to topical antibiotics" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Artificial heart valve" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Artificial joint replacement" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Blood thinners" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Defibrillator" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="MRSA" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Pacemaker" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Requires antibiotics before a surgical procedure" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Rapid heartbeat with epinephrine" Style="{StaticResource Tick}"/>
                                    <CheckBox x:Name="PregnantChk" Content="Pregnant or trying to get pregnant" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Breastfeeding" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="None" Tag="None" Style="{StaticResource Tick}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>
                            <Border x:Name="PregnancyNote" Style="{StaticResource NoticeBox}" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Body}" Foreground="#6B4438"
                                           Text="Pregnant or trying to get pregnant: please also tell the physician verbally."/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 11. preferred pharmacy -->
                    <Border x:Name="SecPharmacy" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Pharmacy name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PharmacyNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Telephone (if known)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PharmacyPhoneTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Address (or cross streets)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PharmacyAddressTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PharmacyCityTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E8E2D3" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="8,10,8,0">
            <DockPanel>
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}" Width="120" Click="CancelBtn_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveBtn" Content="Save registration" Style="{StaticResource SecondaryButton}" Width="170" Margin="0,0,10,0" Click="SaveBtn_Click"/>
                    <Button x:Name="ContinueBtn" Content="Continue to consent  ›" Style="{StaticResource PrimaryButton}" Width="210" Click="ContinueBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="ValidationTxt" Foreground="#B4483F" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="14,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
