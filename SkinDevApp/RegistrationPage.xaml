<Page x:Class="SkinDevApp.Views.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Registration" Background="Transparent">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <StackPanel Grid.Row="1" Margin="8,0,8,10">
            <TextBlock x:Name="PageTitle" Text="Patient registration" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                       Text="Fields marked * are required. Enter identifying details only if the approved research protocol needs them. Photographs are filed under the Patient ID, never under the name."/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SplitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ left column: who the patient is ============ -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Patient details" Style="{StaticResource H2}"/>

                            <TextBlock Text="Patient ID" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                            <TextBox x:Name="PatientIdTxt" Style="{StaticResource Field}" IsReadOnly="True" Background="#EFD7CF" FontWeight="Bold"
                                     HorizontalAlignment="Left" Width="190"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" Text="Created automatically. It cannot be changed."/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="First name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FirstNameTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Middle name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MiddleNameTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Last name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LastNameTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"
                                       Text="Names are optional. Leave them blank if the protocol uses coded IDs only."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Date of birth" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker x:Name="DobPicker" SelectedDateChanged="DobPicker_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Age *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AgeTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Sex *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="SexCombo" Style="{StaticResource Combo}" SelectionChanged="AnyCombo_Changed">
                                        <ComboBoxItem Content="Female"/>
                                        <ComboBoxItem Content="Male"/>
                                        <ComboBoxItem Content="Intersex"/>
                                        <ComboBoxItem Content="Prefer not to say"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Contact details" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ContactTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed" ToolTip="Phone number or e-mail address (optional)"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Recorded by (staff ID) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="OperatorTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" Text="Contact details are optional unless the protocol requires them."/>

                            <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                                <TextBlock Text="Record status" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="StatusCombo" Style="{StaticResource Combo}" SelectionChanged="AnyCombo_Changed">
                                    <ComboBoxItem Content="Active"/>
                                    <ComboBoxItem Content="Withdrawn"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>
                                <TextBlock Text="Reason for this change *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="EditReasonTxt" Style="{StaticResource Field}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"
                                           Text="Changing the registration never alters saved scan results. The change is written to the audit log."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Skin profile" Style="{StaticResource H2}"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Skin type *" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                                    <ComboBox x:Name="SkinTypeCombo" Style="{StaticResource Combo}" SelectionChanged="AnyCombo_Changed">
                                        <ComboBoxItem Content="Oily"/>
                                        <ComboBoxItem Content="Dry"/>
                                        <ComboBoxItem Content="Combination"/>
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Sensitive"/>
                                        <ComboBoxItem Content="Not sure"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Skin sensitivity (self-reported)" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                                    <ComboBox x:Name="SensitivityCombo" Style="{StaticResource Combo}" SelectionChanged="AnyCombo_Changed">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Mild"/>
                                        <ComboBoxItem Content="Moderate"/>
                                        <ComboBoxItem Content="Severe"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="How long has the concern been present?" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="DurationCombo" Style="{StaticResource Combo}" SelectionChanged="AnyCombo_Changed">
                                <ComboBoxItem Content="Not applicable"/>
                                <ComboBoxItem Content="Less than 1 month"/>
                                <ComboBoxItem Content="1 to 6 months"/>
                                <ComboBoxItem Content="6 to 12 months"/>
                                <ComboBoxItem Content="More than 1 year"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ right column: concerns and care ============ -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Skin concerns" Style="{StaticResource H2}"/>

                            <TextBlock Text="Current visible or reported concerns *" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                            <WrapPanel x:Name="ConcernPanel">
                                <CheckBox Content="Acne" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Eczema" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Hyperpigmentation" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="None / Normal" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Other" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                            </WrapPanel>
                            <TextBox x:Name="ConcernOtherTxt" Style="{StaticResource Field}" ToolTip="If you ticked Other, describe the concern" TextChanged="AnyField_Changed"/>

                            <TextBlock Text="Areas of the face affected" Style="{StaticResource FieldLabel}" Margin="0,16,0,5"/>
                            <WrapPanel x:Name="RegionPanel">
                                <CheckBox Content="Forehead" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Left cheek" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Right cheek" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Nose" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Chin" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Multiple areas" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                                <CheckBox Content="Other" Margin="0,4,18,4" Checked="AnyCheck_Changed" Unchecked="AnyCheck_Changed"/>
                            </WrapPanel>
                            <TextBox x:Name="RegionOtherTxt" Style="{StaticResource Field}" ToolTip="If you ticked Other, describe the area" TextChanged="AnyField_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Current skincare and treatments" Style="{StaticResource H2}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Cleanser" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                                    <TextBox x:Name="CleanserTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                    <TextBlock Text="Sunscreen" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SunscreenTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                    <TextBlock Text="Eczema treatment" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EczemaTxTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Moisturizer" Style="{StaticResource FieldLabel}" Margin="0,2,0,5"/>
                                    <TextBox x:Name="MoisturizerTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                    <TextBlock Text="Acne treatment" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AcneTxTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                    <TextBlock Text="Pigmentation treatment" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PigmentTxTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Other products used" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OtherProductsTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                            <TextBlock Text="Recent facial procedures or cosmetics" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProceduresTxt" Style="{StaticResource Field}" TextChanged="AnyField_Changed"/>
                            <TextBlock Text="Other notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OtherResponsesTxt" Style="{StaticResource FieldArea}" TextChanged="AnyField_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Actions -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E8E2D3" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="8,10,8,0">
            <DockPanel>
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}" Width="120" Click="CancelBtn_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveBtn" Content="Save registration" Style="{StaticResource SecondaryButton}" Width="170" Margin="0,0,10,0" Click="SaveBtn_Click"/>
                    <Button x:Name="ContinueBtn" Content="Continue to consent  ›" Style="{StaticResource PrimaryButton}" Width="210" Click="ContinueBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="ValidationTxt" Foreground="#B4483F" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="14,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
