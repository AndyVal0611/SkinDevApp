<Page x:Class="SkinDevApp.Views.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Registration" Background="Transparent">

    <Page.Resources>
        <!-- Every form row uses equal columns with a 16 px gutter. The row is pulled 16 px to the right and every cell gives
             16 px back, so all fields line up with the card's right edge and with the rows above and below. -->
        <Style x:Key="Row" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,-16,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="Req" TargetType="Run">
            <Setter Property="Foreground" Value="#B4483F"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3EFE6"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <!-- fields that only apply after a choice (student, female, multiple lesions): clearly greyed out while they do not apply -->
        <Style x:Key="IfField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EDE8DC"/>
                    <Setter Property="BorderBrush" Value="#E3DCCB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#EEE8DA"/>
            <Setter Property="Margin" Value="0,20,0,4"/>
        </Style>
        <Style x:Key="SubHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5C5D45"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="Tick" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,1,16,1"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- one line of the physical examination: the label on the left, the choices on the right -->
        <Style x:Key="ExamLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,10,16,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <StackPanel Grid.Row="1" Margin="8,0,8,10">
            <TextBlock x:Name="PageTitle" Text="Patient registration" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0">
                This form follows the clinic's patient's chart. Fields marked <Run Text="*" Style="{StaticResource Req}"/> are required. The participant signs the separate paper consent form; no signature is collected on screen.
                Photographs are filed under the Patient ID, never under the name.
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="SplitGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="262"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ section list: jump to a section, see which ones are complete ============ -->
            <Border x:Name="NavCard" Style="{StaticResource Card}" Padding="14,18" VerticalAlignment="Top">
                <StackPanel x:Name="NavPanel"/>
            </Border>

            <ScrollViewer x:Name="FormScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" ScrollChanged="FormScroll_ScrollChanged">
                <StackPanel x:Name="FormStack">

                    <Border x:Name="LegacyNote" Style="{StaticResource NoticeBox}" Margin="8,8,8,4" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Body}" Foreground="#6B4438">
                            <Run FontWeight="SemiBold" Text="Registered with an earlier form."/>
                            <Run Text="The answers from that form are kept unchanged and still appear in the patient record. This chart was not filled in then, so complete what is available. For this patient only the record details, age and sex are required."/>
                        </TextBlock>
                    </Border>

                    <!-- ===================================================== 1. registration record -->
                    <Border x:Name="SecRecord" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Patient ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PatientIdTxt" Style="{StaticResource ReadOnlyField}" Background="#EFD7CF" FontWeight="Bold"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Created automatically. It cannot be changed."/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Date <Run Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="RegDateTxt" Style="{StaticResource ReadOnlyField}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Filled in automatically."/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Recorded by (staff ID) <Run x:Name="OperatorReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="OperatorTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel x:Name="StatusPanel" Visibility="Collapsed">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Style="{StaticResource Cell}">
                                        <TextBlock Text="Record status" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="StatusCombo" Style="{StaticResource Combo}">
                                            <ComboBoxItem Content="Active"/>
                                            <ComboBoxItem Content="Withdrawn"/>
                                            <ComboBoxItem Content="Completed"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                        <TextBlock Style="{StaticResource FieldLabel}">Reason for this change <Run Text="*" Style="{StaticResource Req}"/></TextBlock>
                                        <TextBox x:Name="EditReasonTxt" Style="{StaticResource Field}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Changing the registration never alters saved scan results. The change is written to the audit log."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 2. patient information -->
                    <Border x:Name="SecPatient" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Family name <Run x:Name="LastNameReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="LastNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Given name <Run x:Name="FirstNameReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="FirstNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Middle initial" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MiddleNameTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Birthday <Run x:Name="DobReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <DatePicker x:Name="DobPicker" SelectedDateChanged="DobPicker_Changed"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="MM/DD/YYYY, or pick the date from the calendar."/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock x:Name="AgeLabel" Text="Age (calculated)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AgeTxt" Style="{StaticResource ReadOnlyField}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Sex <Run Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <WrapPanel x:Name="SexPanel">
                                        <RadioButton Content="Male" GroupName="Sex" Style="{StaticResource Choice}"/>
                                        <RadioButton Content="Female" GroupName="Sex" Style="{StaticResource Choice}"/>
                                        <RadioButton x:Name="SexOtherChip" GroupName="Sex" Style="{StaticResource Choice}" Visibility="Collapsed"
                                                     ToolTip="Recorded with an earlier form"/>
                                    </WrapPanel>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Birthplace <Run x:Name="BirthplaceReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="BirthplaceTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Civil status <Run x:Name="CivilReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <ComboBox x:Name="CivilCombo" Style="{StaticResource Combo}">
                                        <ComboBoxItem Content="Single"/>
                                        <ComboBoxItem Content="Married"/>
                                        <ComboBoxItem Content="Widowed"/>
                                        <ComboBoxItem Content="Separated"/>
                                        <ComboBoxItem Content="Annulled"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Citizenship <Run x:Name="CitizenshipReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="CitizenshipTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 3. addresses and contact numbers -->
                    <Border x:Name="SecContact" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}">Home address <Run x:Name="HomeAddressReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                            <TextBox x:Name="HomeAddressTxt" Style="{StaticResource Field}"/>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Tel. #" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="HomeTelTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Cell. # <Run x:Name="HomeCellReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="HomeCellTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="E-mail address" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="EmailTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Provincial address" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ProvAddressTxt" Style="{StaticResource Field}"/>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Tel. #" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ProvTelTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Cell. #" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ProvCellTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 4. occupation and school -->
                    <Border x:Name="SecWork" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Style="{StaticResource FieldLabel}">Occupation <Run x:Name="OccupationReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                                    <TextBox x:Name="OccupationTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Business address" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BizAddressTxt" Style="{StaticResource Field}"/>
                            <UniformGrid Columns="3" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Tel. #" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BizTelTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Cell. #" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BizCellTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Style="{StaticResource FieldLabel}">Is the patient a student? <Run x:Name="StudentReq" Text="*" Style="{StaticResource Req}"/></TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <RadioButton x:Name="StudentYes" Content="Yes" GroupName="Student" Style="{StaticResource Choice}"/>
                                <RadioButton x:Name="StudentNo" Content="No" GroupName="Student" Style="{StaticResource Choice}"/>
                            </StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock x:Name="GradeLabel" Text="Grade / year" Style="{StaticResource FieldLabel}" Margin="0,4,0,5"/>
                                    <TextBox x:Name="GradeTxt" Style="{StaticResource IfField}" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock x:Name="SchoolLabel" Text="School" Style="{StaticResource FieldLabel}" Margin="0,4,0,5"/>
                                    <TextBox x:Name="SchoolTxt" Style="{StaticResource IfField}" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 5. parents -->
                    <Border x:Name="SecParents" Style="{StaticResource Card}">
                        <StackPanel>
                            <UniformGrid Columns="2" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Father's name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="FatherTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Mother's name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="MotherTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 6. present illness -->
                    <Border x:Name="SecIllness" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Date of onset" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="OnsetTxt" Style="{StaticResource Field}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="An exact or approximate date, e.g. June 2026."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Affected area" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AreaTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Described lesions (according to the patient)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DescribedTxt" Style="{StaticResource FieldArea}"/>
                            <UniformGrid Columns="2" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Previous consultation" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ConsultTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Lab. exams" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LabTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Treatment of present illness" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TreatmentTxt" Style="{StaticResource FieldArea}"/>
                            <UniformGrid Columns="2" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Orals" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="OralsTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Topicals" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TopicalsTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 7. personal and past medical history -->
                    <Border x:Name="SecHistory" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Allergy" Style="{StaticResource SubHead}" Margin="0,4,0,0"/>
                            <UniformGrid Columns="2" Style="{StaticResource Row}">
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Food" Style="{StaticResource FieldLabel}" Margin="0,6,0,5"/>
                                    <TextBox x:Name="AllergyFoodTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Drugs" Style="{StaticResource FieldLabel}" Margin="0,6,0,5"/>
                                    <TextBox x:Name="AllergyDrugsTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock x:Name="FemaleHead" Text="If female" Style="{StaticResource SubHead}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource Cell}">
                                    <TextBlock Text="Last menstrual period" Style="{StaticResource FieldLabel}" Margin="0,6,0,5"/>
                                    <TextBox x:Name="LmpTxt" Style="{StaticResource IfField}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource Cell}" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,2">
                                    <CheckBox x:Name="PregnantChk" Content="Pregnant" Style="{StaticResource Tick}" Margin="0,0,28,0"/>
                                    <CheckBox x:Name="BreastfeedingChk" Content="Breastfeeding" Style="{StaticResource Tick}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="FemaleHint" Style="{StaticResource Hint}" Text="Available when the sex is Female."/>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Present medications / supplements" Style="{StaticResource SubHead}" Margin="0,4,0,6"/>
                            <UniformGrid x:Name="SupplementPanel" Columns="3" Style="{StaticResource Row}">
                                <StackPanel>
                                    <CheckBox Content="Vitamin B complex" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Growth hormones" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Vitamin E" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Myra E" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Rogine E" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Stress tabs" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Fish oil" Style="{StaticResource Tick}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Other medications or supplements" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SupplementOtherTxt" Style="{StaticResource Field}"/>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Medical conditions" Style="{StaticResource SubHead}" Margin="0,4,0,6"/>
                            <UniformGrid x:Name="ConditionPanel" Columns="3" Style="{StaticResource Row}">
                                <StackPanel>
                                    <CheckBox Content="Asthma" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Hypertension" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Diabetes mellitus" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Heart disease" Style="{StaticResource Tick}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Other conditions" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ConditionOtherTxt" Style="{StaticResource Field}"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Surgery" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SurgeryTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SurgeryYearTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 8. family medical history -->
                    <Border x:Name="SecFamily" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,6" Text="Tick Father and/or Mother for each condition in the family."/>
                            <ContentControl x:Name="FamilyHost"/>
                            <TextBlock Text="Other conditions in the family" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FamilyOtherTxt" Style="{StaticResource Field}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 9. physical examination (optional) -->
                    <Border x:Name="SecExam" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Number of lesions" Style="{StaticResource ExamLabel}"/>
                                <WrapPanel x:Name="CountPanel" Grid.Column="1" Margin="0,4,0,0" Tag="Optional">
                                    <RadioButton Content="Single" GroupName="LesionCount" Style="{StaticResource Choice}"/>
                                    <RadioButton x:Name="MultipleChip" Content="Multiple" GroupName="LesionCount" Style="{StaticResource Choice}"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
                                        <TextBlock x:Name="NumberLabel" Text="How many" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="LesionNumberTxt" Style="{StaticResource IfField}" Width="110" IsEnabled="False"/>
                                    </StackPanel>
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Text="Itch" Style="{StaticResource ExamLabel}"/>
                                <WrapPanel x:Name="ItchPanel" Grid.Row="1" Grid.Column="1" Tag="Optional">
                                    <RadioButton Content="Pruritic" GroupName="Itch" Style="{StaticResource Choice}"/>
                                    <RadioButton Content="Non-pruritic" GroupName="Itch" Style="{StaticResource Choice}"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="2" Text="Redness" Style="{StaticResource ExamLabel}"/>
                                <WrapPanel x:Name="RednessPanel" Grid.Row="2" Grid.Column="1" Tag="Optional">
                                    <RadioButton Content="Erythematous" GroupName="Redness" Style="{StaticResource Choice}"/>
                                    <RadioButton Content="Non-erythematous" GroupName="Redness" Style="{StaticResource Choice}"/>
                                </WrapPanel>

                                <TextBlock Grid.Row="3" Text="Colour" Style="{StaticResource ExamLabel}"/>
                                <WrapPanel x:Name="ColorPanel" Grid.Row="3" Grid.Column="1" Tag="Optional">
                                    <RadioButton Content="Skin-colored" GroupName="Color" Style="{StaticResource Choice}"/>
                                    <RadioButton Content="Hyperpigmented" GroupName="Color" Style="{StaticResource Choice}"/>
                                    <RadioButton Content="Hypopigmented" GroupName="Color" Style="{StaticResource Choice}"/>
                                </WrapPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0" Text="Tap a selected choice again to clear it."/>

                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Type of lesions" Style="{StaticResource SubHead}" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6" Text="Tick all that apply."/>
                            <UniformGrid x:Name="LesionTypePanel" Columns="3" Style="{StaticResource Row}">
                                <StackPanel>
                                    <CheckBox Content="Macules" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Wheals" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Papules" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Nodular" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Vesicles or bullae" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Pustules" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Cystic" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Excoriations" Style="{StaticResource Tick}"/>
                                </StackPanel>
                                <StackPanel>
                                    <CheckBox Content="Fissures or atrophy" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Scales or lichenification" Style="{StaticResource Tick}"/>
                                    <CheckBox Content="Crusts or plaques" Style="{StaticResource Tick}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Distribution" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DistributionTxt" Style="{StaticResource FieldArea}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===================================================== 10. special tests (optional) -->
                    <Border x:Name="SecTests" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="Wood lamp" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WoodLampTxt" Style="{StaticResource Field}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Style="{StaticResource Cell}">
                                    <TextBlock Text="KOH" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel x:Name="KohPanel" Tag="Optional">
                                        <RadioButton Content="Positive" GroupName="Koh" Style="{StaticResource Choice}"/>
                                        <RadioButton Content="Negative" GroupName="Koh" Style="{StaticResource Choice}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Biopsy" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BiopsyTxt" Style="{StaticResource Field}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E8E2D3" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="8,10,8,0">
            <DockPanel>
                <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}" Width="120" Click="CancelBtn_Click"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveBtn" Content="Save registration" Style="{StaticResource SecondaryButton}" Width="170" Margin="0,0,10,0" Click="SaveBtn_Click"/>
                    <Button x:Name="ContinueBtn" Content="Continue to consent  ›" Style="{StaticResource PrimaryButton}" Width="210" Click="ContinueBtn_Click"/>
                </StackPanel>
                <TextBlock x:Name="ValidationTxt" Foreground="#B4483F" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="14,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
