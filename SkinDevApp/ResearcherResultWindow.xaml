<Window x:Class="SkinDevApp.Views.ResearcherResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMYVUE - Capture Review (Researcher)" Width="1200" Height="820"
        WindowStartupLocation="CenterOwner" Background="#FBF9F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderTxt" FontSize="18" FontWeight="Bold" Foreground="#1A2328"/>
            <TextBlock x:Name="StatusTxt" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
            <TextBlock Foreground="#8A5A00" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="AI output is not ground truth and is never added to training data automatically. Colours show class identity. Each map is normalised per class, so compare its shape, not its brightness. Grad-CAM++ is model attribution, not lesion segmentation."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Images -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Analysed frame" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Border Background="#111827" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                        <Image x:Name="AnalysedImg" MaxHeight="300" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Class-specific Grad-CAM++ overlays" FontWeight="SemiBold" Margin="0,14,0,4"/>
                    <UniformGrid x:Name="OverlayGrid" Columns="2"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Data + review -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Model Class Scores (not independent probabilities)" FontWeight="SemiBold"/>
                    <TextBox x:Name="ScoresBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,4,0,10"/>
                    <TextBlock Text="Details" FontWeight="SemiBold"/>
                    <TextBox x:Name="DetailsBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,4,0,10"/>

                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Researcher review" FontWeight="SemiBold"/>
                            <TextBlock Text="Your label" Margin="0,8,0,2" FontSize="12"/>
                            <ComboBox x:Name="LabelCombo"/>
                            <TextBlock Text="Reviewer name" Margin="0,8,0,2" FontSize="12"/>
                            <TextBox x:Name="ReviewerBox"/>
                            <TextBlock Text="Comment" Margin="0,8,0,2" FontSize="12"/>
                            <TextBox x:Name="CommentBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="SaveBtn" Content="Save review" Margin="0,10,0,0" Height="32"
                                    Click="SaveBtn_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="PrevBtn" Content="&lt; Previous pending" Width="140" Height="32" Click="PrevBtn_Click"/>
            <Button x:Name="NextBtn" Content="Next pending &gt;" Width="140" Height="32" Margin="8,0,0,0" Click="NextBtn_Click"/>
            <Button Content="Open folder" Width="110" Height="32" Margin="8,0,0,0" Click="OpenFolderBtn_Click"/>
            <Button Content="Comparison gallery" Width="150" Height="32" Margin="8,0,0,0" Click="GalleryBtn_Click"/>
            <Button Content="Close" Width="90" Height="32" DockPanel.Dock="Right" Click="CloseBtn_Click"/>
        </DockPanel>
    </Grid>
</Window>
