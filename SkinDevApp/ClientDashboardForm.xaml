<Page x:Class="SkinDevApp.Views.ClientDashboardForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ClientDashboardForm" SizeChanged="Page_SizeChanged" Background="Transparent">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: participant, scan session, Front / Left / Right progress, required pose -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="16" Padding="20,12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Dashboard" Style="{StaticResource HeaderButton}" Click="HomeBtn_Click"/>
                    <Button Content="Sign out" Style="{StaticResource HeaderButton}" Click="LogoutBtn_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LUMYVUE" Foreground="White" FontSize="24" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic"/>
                        <TextBlock Text="  PrecisionSkin  ·  Multi-View Scan" Foreground="#F0EFD8" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ScanInfoTxt" Text="" Foreground="#F0EFD8" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dynamic Responsive Grid -->
        <Grid x:Name="ContentGrid" Grid.Row="1">

            <!-- Camera / Photo View Card -->
            <Border x:Name="ImageCard" Background="#2D2E22" CornerRadius="16" Padding="0" Margin="8" ClipToBounds="True">
                <Grid x:Name="CameraViewportGrid" ClipToBounds="True" Background="Transparent" SizeChanged="CameraViewportGrid_SizeChanged">
                    <Grid x:Name="ZoomLayer">
                    <Image x:Name="UploadedImageViewer"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Canvas layer for Drawing AI Detection Dots (kept from the previous version) -->
                    <Canvas x:Name="DetectionDotsCanvas" IsHitTestVisible="False"/>

                    <!-- Face-positioning guide: oval + short instruction. Shown only while the camera is live. -->
                    <Canvas x:Name="GuideCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                        <Line x:Name="CentreV" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                        <Line x:Name="CentreH" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                        <Ellipse x:Name="GuideOval" Stroke="#99FFFFFF" StrokeThickness="3"
                                 StrokeDashArray="4,3" Fill="Transparent"/>
                    </Canvas>
                    </Grid>

                    <!-- Top: scan state banner -->
                    <Border x:Name="StateBanner" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="#B3000000" CornerRadius="14" Padding="14,6" IsHitTestVisible="False">
                        <TextBlock x:Name="StateTxt" Text="" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </Border>

                    <!-- Bottom centre: positioning instruction + hold-still progress -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14" IsHitTestVisible="False">
                        <Border x:Name="GuideBanner" Visibility="Collapsed"
                                Background="#B3000000" CornerRadius="14" Padding="16,7" HorizontalAlignment="Center">
                            <TextBlock x:Name="GuideTxt" Text="" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <ProgressBar x:Name="HoldBar" Minimum="0" Maximum="1" Value="0" Height="6" Width="220"
                                     Margin="0,8,0,0" Foreground="#22C55E" Background="#55FFFFFF"
                                     BorderThickness="0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Live service status (kept) -->
                    <TextBlock x:Name="LiveStatusTxt"
                               Text=""
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="White" Background="#99000000"
                               Padding="8,4" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               Margin="10" IsHitTestVisible="False"/>

                    <!-- Colour legend: colour = class, opacity = attribution strength -->
                    <Border x:Name="LegendPanel" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,52,10,0"
                            Background="#B3000000" CornerRadius="10" Padding="10,8" IsHitTestVisible="False">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse Width="10" Height="10" Fill="#FF0000" Margin="0,0,6,0"/>
                                <TextBlock Text="Acne" FontSize="11" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse Width="10" Height="10" Fill="#0050FF" Margin="0,0,6,0"/>
                                <TextBlock Text="Hyperpigmentation" FontSize="11" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse Width="10" Height="10" Fill="#FFBE00" Margin="0,0,6,0"/>
                                <TextBlock Text="Eczema" FontSize="11" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Ellipse Width="10" Height="10" Fill="#00C83C" Margin="0,0,6,0"/>
                                <TextBlock Text="Normal" FontSize="11" Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text="Colour = class&#x0a;Opacity = strength" FontSize="9" Foreground="#CCFFFFFF"/>
                        </StackPanel>
                    </Border>

                    <!-- Zoom buttons (touch-sized). The picture can also be pinched with two fingers, or zoomed with the mouse wheel. -->
                    <Border x:Name="ZoomControls" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,14,14,56"
                            Background="#99000000" CornerRadius="32" Padding="4,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=PlaceholderPanel}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Button x:Name="ZoomInBtn" Content="+" Style="{StaticResource ZoomButton}" ToolTip="Zoom in" Click="ZoomInBtn_Click"/>
                            <TextBlock x:Name="ZoomLevelTxt" Text="1.0×" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                            <Button x:Name="ZoomOutBtn" Content="−" Style="{StaticResource ZoomButton}" ToolTip="Zoom out" Click="ZoomOutBtn_Click"/>
                            <Button x:Name="ZoomResetBtn" Content="⟲" FontSize="22" Style="{StaticResource ZoomButton}" ToolTip="Back to the original view" Click="ZoomResetBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Initial Placeholder -->
                    <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x2728;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Open Live Cam or Upload Image to Start Evaluation"
                                   FontSize="16" Foreground="#9B9B84" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results Panel -->
            <Border x:Name="ControlsCard" Background="White" BorderBrush="#E8E2D3" BorderThickness="1" CornerRadius="16" Padding="25" Margin="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Participant / consent gate message -->
                        <Border x:Name="GateBox" Style="{StaticResource NoticeBox}" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="GateTxt" FontSize="13" Foreground="#3A3B2C" TextWrapping="Wrap"/>
                                <Button x:Name="GateBtn" Content="Go to Consent" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="GateBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- A database save failed: stays visible until it succeeds -->
                        <Border x:Name="SaveWarnBox" Visibility="Collapsed" Background="#FDECEC" BorderBrush="#F3B4B4"
                                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="SaveWarnTxt" FontSize="12.5" Foreground="#7F1D1D" TextWrapping="Wrap"/>
                                <Button x:Name="RetrySaveBtn" Content="Retry save" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="RetrySaveBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Review: per-view quality, retake, accept -->
                        <Border x:Name="ReviewPanel" Visibility="Collapsed" Background="#F8EBE6" BorderBrush="#E8CCC2"
                                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Image Review" FontSize="17" FontWeight="Bold" Foreground="#3A3B2C"/>
                                <TextBlock Text="Check each captured view. Retake any view without repeating registration. Results are finalised when you accept."
                                           FontSize="11.5" Foreground="#6F6F58" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                <StackPanel x:Name="ReviewList"/>
                                <Button x:Name="AcceptBtn" Content="Accept views and view results  ›" Style="{StaticResource PrimaryButton}"
                                        Margin="0,10,0,0" Click="AcceptBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Camera / File Controls -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartCamBtn" Grid.Column="0" Content="&#x1F4F7; Live Cam" Height="62" FontSize="14"
                                    Background="#D0D1A5" Foreground="#3A3B2C" FontWeight="SemiBold" BorderThickness="0" Click="StartCamBtn_Click"/>

                            <Button x:Name="SnapBtn" Grid.Column="2" Content="&#x1F4F8; Snap Now" Height="62" FontSize="14"
                                    Background="#DDBAAE" Foreground="#3A3B2C" FontWeight="Bold" BorderThickness="0" IsEnabled="False" Click="SnapBtn_Click"/>

                            <Button x:Name="UploadBtn" Grid.Column="4" Content="&#x1F4C1; File Upload" Height="62" FontSize="14"
                                    Background="#D0D1A5" Foreground="#3A3B2C" FontWeight="SemiBold" BorderThickness="0" Click="UploadBtn_Click"/>
                        </Grid>

                        <CheckBox x:Name="AutoCaptureChk" Content="Take the photo automatically when the reading is steady" IsChecked="True"
                                  FontSize="14" Foreground="#3A3B2C" Margin="0,0,0,10"
                                  Checked="AutoCaptureChk_Changed" Unchecked="AutoCaptureChk_Changed"/>

                        <CheckBox x:Name="MultiViewChk" Content="Three photographs: front, left side and right side" IsChecked="True"
                                  FontSize="14" Foreground="#3A3B2C" Margin="0,0,0,6"
                                  Checked="MultiViewChk_Changed" Unchecked="MultiViewChk_Changed"/>

                        <CheckBox x:Name="CentreChk" Content="Show centre lines (height and left / right)" IsChecked="True"
                                  FontSize="14" Foreground="#3A3B2C" Margin="0,0,0,10"
                                  Checked="CentreChk_Changed" Unchecked="CentreChk_Changed"/>

                        <UniformGrid x:Name="StepperGrid" Columns="3" Margin="0,2,0,6" Visibility="Collapsed"/>
                        <TextBlock x:Name="ViewStepTxt" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#6E6F52"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Camera and picture size (the sharpest picture is used unless another size is chosen) -->
                        <Border x:Name="CameraBox" Background="#EFD7CF" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Camera" FontSize="12" Foreground="#6F6F58" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CameraCombo" Style="{StaticResource Combo}" Margin="0,0,0,10" SelectionChanged="CameraCombo_SelectionChanged"/>
                                <TextBlock Text="Picture size" FontSize="12" Foreground="#6F6F58" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SizeCombo" Style="{StaticResource Combo}" SelectionChanged="SizeCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Live capture status (face, pose, sharpness, exposure, motion, stability, camera) -->
                        <Border x:Name="StatusPanel" Background="#EFD7CF" CornerRadius="10" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Prediction stability" FontSize="12" Foreground="#6F6F58" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StabilityTxt" Text="ANALYZING" FontSize="15" FontWeight="Bold" Foreground="#3A3B2C"
                                               HorizontalAlignment="Right"/>
                                </DockPanel>
                                <UniformGrid x:Name="StatusGrid" Columns="2"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="NewScanBtn" Content="&#x1F501; New Scan" Height="56" FontSize="14"
                                Background="#3A3B2C" Foreground="White" FontWeight="Bold" IsEnabled="False"
                                Margin="0,0,0,10" Click="NewScanBtn_Click"/>

                        <Button x:Name="AnalyzeBtn" Content="&#x1F33F; Analyse uploaded image (researcher)" Height="56" FontSize="14"
                                Background="#3A3B2C" Foreground="White" FontWeight="Bold" IsEnabled="False" Margin="0,0,0,14" Click="AnalyzeBtn_Click"/>

                        <Separator Margin="0,0,0,14" Background="#F1F5F9"/>

                        <TextBlock Text="Model Class Scores" FontSize="16" FontWeight="Bold" Foreground="#3A3B2C" Margin="0,0,0,2"/>
                        <TextBlock Text="The model's scores across four mutually exclusive classes. They are not independent disease probabilities."
                                   FontSize="10.5" Foreground="#6F6F58" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Progress Bars for 4 target classes (colours = heatmap colours) -->
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Acne" FontSize="13" Foreground="#3A3B2C" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AcneScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#3A3B2C"/>
                            </DockPanel>
                            <ProgressBar x:Name="AcneBar" Height="8" Foreground="#FF0000" Background="#F6F3EA" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Hyperpigmentation" FontSize="13" Foreground="#3A3B2C" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HyperScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#3A3B2C"/>
                            </DockPanel>
                            <ProgressBar x:Name="HyperBar" Height="8" Foreground="#0050FF" Background="#F6F3EA" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Eczema" FontSize="13" Foreground="#3A3B2C" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EczemaScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#3A3B2C"/>
                            </DockPanel>
                            <ProgressBar x:Name="EczemaBar" Height="8" Foreground="#FFBE00" Background="#F6F3EA" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Normal" FontSize="13" Foreground="#3A3B2C" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NormalScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#3A3B2C"/>
                            </DockPanel>
                            <ProgressBar x:Name="NormalBar" Height="8" Foreground="#00C83C" Background="#F6F3EA" Minimum="0" Maximum="100" Margin="0,0,0,14"/>
                        </StackPanel>

                        <!-- Primary Result Callout -->
                        <Border Background="#F6F3EA" BorderBrush="#D0D1A5" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="VerdictTxt" Text="Status: Awaiting camera / image" FontSize="14" FontWeight="Bold" Foreground="#3A3B2C" TextWrapping="Wrap"/>
                                <TextBlock x:Name="RegionTxt" Text="" FontSize="12" FontStyle="Italic" Foreground="#5A5A45" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DisclaimerTxt"
                                   Text="Screening aid only. Not a medical diagnosis. Heatmaps show regions that influenced the model, not lesion outlines. Results are pending review."
                                   FontSize="10.5" Foreground="#6F6F58" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Expander x:Name="MoreOptions" Header="More options" FontSize="14" FontWeight="SemiBold" Foreground="#3A3B2C" Margin="0,0,0,14">
                            <StackPanel Margin="0,10,0,0">
                        <!-- Which heatmap is drawn on the image (researcher CAM target class) -->
                        <StackPanel x:Name="HeatmapChoicePanel">
                        <TextBlock Text="CAM target class" FontSize="12" FontWeight="SemiBold" Foreground="#3A3B2C" Margin="0,0,0,4"/>
                        <WrapPanel Margin="0,0,0,14">
                            <RadioButton x:Name="ViewPredictedRb" GroupName="OverlayView" Content="Predicted" IsChecked="True" Margin="0,0,12,4" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewAllRb" GroupName="OverlayView" Content="All classes" Margin="0,0,12,4" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewAcneRb" GroupName="OverlayView" Content="Acne" Foreground="#CC0000" Margin="0,0,12,4" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewHyperRb" GroupName="OverlayView" Content="Hyperpigmentation" Foreground="#0040CC" Margin="0,0,12,4" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewEczemaRb" GroupName="OverlayView" Content="Eczema" Foreground="#B38600" Margin="0,0,12,4" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewNormalRb" GroupName="OverlayView" Content="Normal" Foreground="#008A28" Margin="0,0,12,4" FontSize="12" Checked="OverlayViewRb_Checked"/>
                        </WrapPanel>
                        </StackPanel>

                        <!-- Researcher view -->
                        <CheckBox x:Name="ResearcherChk" Content="Researcher view" FontSize="12" Foreground="#3A3B2C"
                                  Margin="0,0,0,8" Checked="ResearcherChk_Changed" Unchecked="ResearcherChk_Changed"/>

                        <Border x:Name="ResearcherPanel" Visibility="Collapsed" Background="#EFD7CF" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CAM controls" FontSize="12" FontWeight="Bold" Foreground="#3A3B2C" Margin="0,0,0,4"/>
                                <CheckBox x:Name="CamOnChk" Content="Live Grad-CAM++ ON" IsChecked="True" FontSize="12" Margin="0,0,0,6"
                                          Checked="CamOnChk_Changed" Unchecked="CamOnChk_Changed"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Overlay opacity" FontSize="12" Width="100" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OpacityTxt" DockPanel.Dock="Right" Width="40" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="ResearcherMetricsTxt" Text="" FontFamily="Consolas" FontSize="11" Foreground="#2D2E22" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="OpenDetailsBtn" Content="Capture details / review" Height="32" Padding="12,0" Margin="0,0,8,0"
                                            IsEnabled="False" Click="OpenDetailsBtn_Click"/>
                                    <Button x:Name="GalleryBtn" Content="Comparison gallery" Height="32" Padding="12,0" Margin="0,0,8,0"
                                            IsEnabled="False" Click="GalleryBtn_Click"/>
                                    <Button x:Name="PendingBtn" Content="Pending reviews" Height="32" Padding="12,0" Click="PendingBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            </StackPanel>
                        </Expander>

                        <!-- Results / report (enabled once the scan is saved) -->
                        <Button x:Name="ViewResultsBtn" Content="View results  ›" Style="{StaticResource PrimaryButton}" Height="58"
                                IsEnabled="False" Margin="0,0,0,8" Click="ViewResultsBtn_Click"/>
                        <Button x:Name="PrintBtn" Content="&#x1F5A8;&#xFE0F; Create report" Height="56" FontSize="14"
                                Background="#DDBAAE" Foreground="#3A3B2C" FontWeight="Bold" BorderThickness="0"
                                IsEnabled="False" Click="PrintBtn_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
