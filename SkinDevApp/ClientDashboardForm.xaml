<Page x:Class="SkinDevApp.Views.ClientDashboardForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ClientDashboardForm" SizeChanged="Page_SizeChanged" Background="#FBF9F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Clinic Bar -->
        <Border Grid.Row="0" Background="#1A2328" CornerRadius="16" Padding="20,15" Margin="0,0,0,20">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LUMYVUE" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text=" |  Skin Health Monitor" Foreground="#E0B0A2" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Content="Sign Out" Width="95" Height="36" Background="Transparent" Foreground="#E0B0A2" 
                        BorderBrush="#E0B0A2" BorderThickness="1" HorizontalAlignment="Right" Click="LogoutBtn_Click"/>
            </DockPanel>
        </Border>

        <!-- Dynamic Responsive Grid -->
        <Grid x:Name="ContentGrid" Grid.Row="1">

            <!-- Camera / Photo View Card -->
            <Border x:Name="ImageCard" Background="#111827" CornerRadius="16" Padding="0" Margin="8" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.04" Direction="270"/>
                </Border.Effect>
                <Grid x:Name="CameraViewportGrid" ClipToBounds="True">
                    <Image x:Name="UploadedImageViewer" 
                           Stretch="UniformToFill" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                    <!-- Canvas layer for Drawing AI Detection Dots -->
                    <Canvas x:Name="DetectionDotsCanvas" IsHitTestVisible="False"/>

                    <!-- Initial Placeholder -->
                    <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✨" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Open Live Cam or Upload Image to Start Evaluation" 
                                   FontSize="16" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Diagnostic Results Panel -->
            <Border x:Name="ControlsCard" Background="White" CornerRadius="16" Padding="25" Margin="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.03" Direction="270"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Camera / File Controls -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartCamBtn" Grid.Column="0" Content="📷 Live Cam" Height="46" FontSize="12" 
                                    Background="#E2EADF" Foreground="#1A2328" FontWeight="SemiBold" BorderThickness="0" Click="StartCamBtn_Click"/>

                            <Button x:Name="SnapBtn" Grid.Column="2" Content="📸 Snap Frame" Height="46" FontSize="12" 
                                    Background="#E0B0A2" Foreground="#1A2328" FontWeight="Bold" BorderThickness="0" IsEnabled="False" Click="SnapBtn_Click"/>

                            <Button x:Name="UploadBtn" Grid.Column="4" Content="📁 File Upload" Height="46" FontSize="12" 
                                    Background="#E2EADF" Foreground="#1A2328" FontWeight="SemiBold" BorderThickness="0" Click="UploadBtn_Click"/>
                        </Grid>

                        <Button x:Name="AnalyzeBtn" Content="🌿 Run Aesthetic Analysis" Height="52" FontSize="14" 
                                Background="#1A2328" Foreground="White" FontWeight="Bold" IsEnabled="False" Margin="0,0,0,16" Click="AnalyzeBtn_Click"/>

                        <Separator Margin="0,0,0,16" Background="#F1F5F9"/>

                        <TextBlock Text="Dermatological Assessment" FontSize="16" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,12"/>

                        <!-- Progress Bars for 4 Target Classes -->
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Acne" FontSize="13" Foreground="#1A2328" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AcneScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="AcneBar" Height="8" Foreground="#E0B0A2" Background="#FBF9F6" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Hyperpigmentation" FontSize="13" Foreground="#1A2328" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HyperScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="HyperBar" Height="8" Foreground="#D4A373" Background="#FBF9F6" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Eczema" FontSize="13" Foreground="#1A2328" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EczemaScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="EczemaBar" Height="8" Foreground="#A3B18A" Background="#FBF9F6" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Normal" FontSize="13" Foreground="#1A2328" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NormalScoreTxt" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1A2328"/>
                            </DockPanel>
                            <ProgressBar x:Name="NormalBar" Height="8" Foreground="#588157" Background="#FBF9F6" Minimum="0" Maximum="100" Margin="0,0,0,16"/>
                        </StackPanel>

                        <!-- Primary Result Callout -->
                        <Border Background="#FBF9F6" BorderBrush="#E2EADF" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                            <TextBlock x:Name="VerdictTxt" Text="Primary Status: Awaiting Camera / Image" FontSize="14" FontWeight="Bold" Foreground="#1A2328"/>
                        </Border>

                        <!-- PRINT FORM BUTTON (Enabled after analysis) -->
                        <Button x:Name="PrintBtn" Content="🖨️ Print Assessment Report" Height="48" FontSize="13" 
                                Background="#E0B0A2" Foreground="#1A2328" FontWeight="Bold" BorderThickness="0" 
                                IsEnabled="False" Click="PrintBtn_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>