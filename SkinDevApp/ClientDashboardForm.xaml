<Page x:Class="SkinDevApp.Views.ClientDashboardForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ClientDashboardForm" SizeChanged="Page_SizeChanged" Background="Transparent">

    <!-- =====================================================================================
         LUMYVUE scan workstation.
         Landscape (16:9): camera | capture column | AI analysis column, so everything is visible without scrolling.
         Narrower windows: camera | one column with both panels.  Portrait: camera on top, panels below.
         (The arrangement is chosen in ClientDashboardForm.Touch.cs, ApplyAdaptiveLayout.)
         ===================================================================================== -->

    <Page.Resources>
        <!-- camera overlay chips: dark glass so they read on any picture -->
        <Style x:Key="GlassChip" TargetType="Border">
            <Setter Property="Background" Value="#B82A2B20"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style x:Key="ScoreName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2F3024"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ScoreValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2F3024"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}"/>
        </Style>
        <Style x:Key="ScoreBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#EFEADC"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
        </Style>
        <Style x:Key="ScoreDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- one corner of the viewfinder frame -->
        <Style x:Key="Corner" TargetType="Path">
            <Setter Property="Stroke" Value="#80FFFFFF"/>
            <Setter Property="StrokeThickness" Value="2.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Data" Value="M0,22 V6 A6,6 0 0 1 6,0 H22"/>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="18" Padding="22,12,14,12" Margin="8,0,8,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LUMYVUE" Foreground="White" FontSize="26" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic"/>
                    <ContentControl Style="{StaticResource SkinRibbon}" Margin="2,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="34" Background="#40FFFFFF" Margin="20,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Skin scan" Foreground="#F7F5E9" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScanInfoTxt" Text="" Foreground="#DDDCC2" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderButton}" ToolTip="Dashboard" Click="HomeBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Home}" Width="17" Height="17" Margin="0,0,8,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" ToolTip="Sign out" Click="LogoutBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Logout}" Width="17" Height="17" Margin="0,0,8,0"/>
                            <TextBlock Text="Sign out" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================ workstation -->
        <Grid x:Name="ContentGrid" Grid.Row="1">

            <!-- ============================================ camera (the centerpiece) -->
            <Border x:Name="ImageCard" Background="#25261C" CornerRadius="22" Padding="0" Margin="8" ClipToBounds="True">
                <Grid x:Name="CameraViewportGrid" ClipToBounds="True" Background="Transparent" SizeChanged="CameraViewportGrid_SizeChanged">
                    <Grid x:Name="ZoomLayer">
                    <Image x:Name="UploadedImageViewer"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Canvas layer for Drawing AI Detection Dots (kept from the previous version) -->
                    <Canvas x:Name="DetectionDotsCanvas" IsHitTestVisible="False"/>

                    <!-- Face-positioning guide: oval + centre lines. Shown only while the camera is live. -->
                    <Canvas x:Name="GuideCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                        <Line x:Name="CentreV" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                        <Line x:Name="CentreH" Stroke="#66FFFFFF" StrokeThickness="1.5" StrokeDashArray="2,4"/>
                        <Ellipse x:Name="GuideOval" Stroke="#99FFFFFF" StrokeThickness="3"
                                 StrokeDashArray="4,3" Fill="Transparent"/>
                    </Canvas>
                    </Grid>

                    <!-- viewfinder corners -->
                    <Path Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"/>
                    <Path Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                    </Path>
                    <Path Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform ScaleY="-1"/></Path.RenderTransform>
                    </Path>
                    <Path Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Path.RenderTransform>
                    </Path>

                    <!-- Top: scan state banner -->
                    <Border x:Name="StateBanner" Style="{StaticResource GlassChip}" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="56,16,56,0" Padding="16,8" IsHitTestVisible="False">
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Fill="#C2C395" Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="StateTxt" Text="" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- Bottom centre: positioning instruction + hold-still progress -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" IsHitTestVisible="False">
                        <Border x:Name="GuideBanner" Style="{StaticResource GlassChip}" Visibility="Collapsed" Padding="20,9" Margin="56,0,56,0" HorizontalAlignment="Center" CornerRadius="20">
                            <TextBlock x:Name="GuideTxt" Text="" FontSize="19" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                        <ProgressBar x:Name="HoldBar" Minimum="0" Maximum="1" Value="0" Height="6" Width="240"
                                     Margin="0,10,0,0" Foreground="#C2C395" Background="#55FFFFFF"
                                     BorderThickness="0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Live service status (kept) -->
                    <TextBlock x:Name="LiveStatusTxt"
                               Text=""
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="White" Background="#99000000"
                               Padding="10,5" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               Margin="22,0,0,22" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Colour legend: colour = class, opacity = attribution strength -->
                    <Border x:Name="LegendPanel" Style="{StaticResource GlassChip}" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,64,20,0" Padding="14,10" IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock Text="HEAT MAP" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10" Height="10" Fill="#FF0000" Margin="0,0,8,0"/>
                                <TextBlock Text="Acne" FontSize="11.5" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10" Height="10" Fill="#0050FF" Margin="0,0,8,0"/>
                                <TextBlock Text="Hyperpigmentation" FontSize="11.5" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="10" Height="10" Fill="#FFBE00" Margin="0,0,8,0"/>
                                <TextBlock Text="Eczema" FontSize="11.5" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="10" Height="10" Fill="#00C83C" Margin="0,0,8,0"/>
                                <TextBlock Text="Normal" FontSize="11.5" Foreground="White"/>
                            </StackPanel>
                            <TextBlock Text="Colour = category&#x0a;Strength = how much it counted" FontSize="10" Foreground="#CCFFFFFF"/>
                        </StackPanel>
                    </Border>

                    <!-- Zoom buttons (touch-sized). The picture can also be pinched with two fingers, or zoomed with the mouse wheel. -->
                    <Border x:Name="ZoomControls" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,14,20,64"
                            Background="#B82A2B20" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="32" Padding="4,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=PlaceholderPanel}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Button x:Name="ZoomInBtn" Style="{StaticResource ZoomButton}" ToolTip="Zoom in" Click="ZoomInBtn_Click">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Plus}" Width="22" Height="22" Margin="0,3,0,0"/>
                            </Button>
                            <TextBlock x:Name="ZoomLevelTxt" Text="1.0×" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2"/>
                            <Button x:Name="ZoomOutBtn" Style="{StaticResource ZoomButton}" ToolTip="Zoom out" Click="ZoomOutBtn_Click">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Minus}" Width="22" Height="22" Margin="0,3,0,0"/>
                            </Button>
                            <Button x:Name="ZoomResetBtn" Style="{StaticResource ZoomButton}" ToolTip="Back to the original view" Click="ZoomResetBtn_Click">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Refresh}" Width="21" Height="21" Margin="0,3,0,0"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Initial Placeholder -->
                    <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="96" Height="96" CornerRadius="48" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                            <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Camera}" Foreground="#E9E7CF" Width="42" Height="42" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ready when you are" FontSize="22" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic"
                                   Foreground="#F7F5E9" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="Start the live camera, or upload a photograph to evaluate."
                                   FontSize="14" Foreground="#BDBCA4" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================ capture column -->
            <Border x:Name="ControlsCard" Style="{StaticResource Card}" Padding="22,20,22,20" Margin="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CAPTURE" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Three-angle scan" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                        <!-- Participant / consent gate message -->
                        <Border x:Name="GateBox" Style="{StaticResource NoticeBox}" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Shield}" Foreground="#B9897A" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="GateTxt" FontSize="13" Foreground="#2F3024" TextWrapping="Wrap"/>
                                </DockPanel>
                                <Button x:Name="GateBtn" Content="Go to Consent" Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                        Margin="30,10,0,0" Click="GateBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- A database save failed: stays visible until it succeeds -->
                        <Border x:Name="SaveWarnBox" Visibility="Collapsed" Background="#F8E6E2" BorderBrush="#E9B7AE"
                                BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Alert}" Foreground="#A93D33" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="SaveWarnTxt" FontSize="12.5" Foreground="#7F1D1D" TextWrapping="Wrap"/>
                                </DockPanel>
                                <Button x:Name="RetrySaveBtn" Content="Retry save" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left" Margin="30,10,0,0" Click="RetrySaveBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Image Review: per-view quality, retake, accept -->
                        <Border x:Name="ReviewPanel" Visibility="Collapsed" Background="#F8EBE6" BorderBrush="#E8CCC2"
                                BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Image}" Foreground="#B9897A" Width="20" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Image review" FontSize="17" FontWeight="SemiBold" Foreground="#2F3024"/>
                                </DockPanel>
                                <TextBlock Text="Check each photograph. Retake any view without repeating registration. Results are finalised when you accept."
                                           FontSize="12" Foreground="#6F6F58" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <StackPanel x:Name="ReviewList"/>
                                <Button x:Name="AcceptBtn" Content="Accept views and view results  ›" Style="{StaticResource PrimaryButton}"
                                        Margin="0,10,0,0" Click="AcceptBtn_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Camera / File Controls -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartCamBtn" Grid.Column="0" Style="{StaticResource PrimaryButton}" Height="64" FontSize="15" Padding="10,0" Click="StartCamBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Video}" Width="22" Height="22" Margin="0,0,10,0"/>
                                    <TextBlock Text="Live Cam" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="SnapBtn" Grid.Column="2" Style="{StaticResource AccentButton}" Height="64" FontSize="15" FontWeight="Bold" Padding="10,0" IsEnabled="False" Click="SnapBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Capture}" Width="22" Height="22" Margin="0,0,10,0"/>
                                    <TextBlock Text="Snap Now" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button x:Name="UploadBtn" Style="{StaticResource GhostButton}" Height="50" Margin="0,0,0,16" Click="UploadBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Upload}" Width="19" Height="19" Margin="0,0,10,0"/>
                                <TextBlock Text="File Upload" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- front / left / right stages -->
                        <TextBlock Text="STAGES" Style="{StaticResource Eyebrow}"/>
                        <UniformGrid x:Name="StepperGrid" Columns="3" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <TextBlock x:Name="ViewStepTxt" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#5F6048"
                                   TextWrapping="Wrap" Margin="2,0,0,14"/>

                        <!-- capture options -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="14,6">
                            <StackPanel>
                                <CheckBox x:Name="AutoCaptureChk" Content="Take the photo automatically when the reading is steady" IsChecked="True"
                                          FontSize="13.5" Foreground="#2F3024" Margin="0,2,0,2"
                                          Checked="AutoCaptureChk_Changed" Unchecked="AutoCaptureChk_Changed"/>

                                <CheckBox x:Name="MultiViewChk" Content="Three photographs: front, left side and right side" IsChecked="True"
                                          FontSize="13.5" Foreground="#2F3024" Margin="0,2,0,2"
                                          Checked="MultiViewChk_Changed" Unchecked="MultiViewChk_Changed"/>

                                <CheckBox x:Name="CentreChk" Content="Show centre lines (height and left / right)" IsChecked="True"
                                          FontSize="13.5" Foreground="#2F3024" Margin="0,2,0,2"
                                          Checked="CentreChk_Changed" Unchecked="CentreChk_Changed"/>
                            </StackPanel>
                        </Border>

                        <!-- Camera and picture size (the sharpest picture is used unless another size is chosen) -->
                        <Border x:Name="CameraBox" Style="{StaticResource Panel}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Camera}" Foreground="#6F6F58" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Camera" FontSize="12" FontWeight="SemiBold" Foreground="#6F6F58"/>
                                </DockPanel>
                                <ComboBox x:Name="CameraCombo" Style="{StaticResource Combo}" Margin="0,0,0,12" SelectionChanged="CameraCombo_SelectionChanged"/>
                                <DockPanel Margin="0,0,0,6">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Image}" Foreground="#6F6F58" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="Picture size" FontSize="12" FontWeight="SemiBold" Foreground="#6F6F58"/>
                                </DockPanel>
                                <ComboBox x:Name="SizeCombo" Style="{StaticResource Combo}" SelectionChanged="SizeCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="NewScanBtn" Style="{StaticResource GhostButton}" Height="54" IsEnabled="False"
                                Margin="0,0,0,10" Click="NewScanBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Refresh}" Width="19" Height="19" Margin="0,0,10,0"/>
                                <TextBlock Text="New Scan" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AnalyzeBtn" Style="{StaticResource SecondaryButton}" Height="54" IsEnabled="False" Margin="0,0,0,4" Click="AnalyzeBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Sparkle}" Width="19" Height="19" Margin="0,0,10,0"/>
                                <TextBlock Text="Analyse uploaded image (researcher)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================================ AI analysis column -->
            <Border x:Name="AnalysisCard" Style="{StaticResource Card}" Padding="22,20,22,20" Margin="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="AI ANALYSIS" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="Live reading" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                        <!-- Live capture status (face, pose, sharpness, exposure, motion, stability, camera) -->
                        <Border x:Name="StatusPanel" Style="{StaticResource Panel}" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Prediction stability" FontSize="12" FontWeight="SemiBold" Foreground="#6F6F58" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Right" Background="#2F3024" CornerRadius="10" Padding="10,3">
                                        <TextBlock x:Name="StabilityTxt" Text="ANALYZING" FontSize="11.5" FontWeight="Bold" Foreground="#F7F5E9"/>
                                    </Border>
                                </DockPanel>
                                <UniformGrid x:Name="StatusGrid" Columns="2"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,2">
                            <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Chart}" Foreground="#818263" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Model class scores" FontSize="15" FontWeight="SemiBold" Foreground="#2F3024"/>
                        </DockPanel>
                        <TextBlock Text="The model's scores across four mutually exclusive classes. They are not independent disease probabilities."
                                   FontSize="11" Foreground="#6F6F58" TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <!-- Progress Bars for 4 target classes (colours = heatmap colours) -->
                        <StackPanel>
                            <DockPanel>
                                <Ellipse Style="{StaticResource ScoreDot}" Fill="#FF0000"/>
                                <TextBlock x:Name="AcneScoreTxt" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource ScoreValue}"/>
                                <TextBlock Text="Acne" Style="{StaticResource ScoreName}"/>
                            </DockPanel>
                            <ProgressBar x:Name="AcneBar" Style="{StaticResource ScoreBar}" Foreground="#FF0000"/>

                            <DockPanel>
                                <Ellipse Style="{StaticResource ScoreDot}" Fill="#0050FF"/>
                                <TextBlock x:Name="HyperScoreTxt" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource ScoreValue}"/>
                                <TextBlock Text="Hyperpigmentation" Style="{StaticResource ScoreName}"/>
                            </DockPanel>
                            <ProgressBar x:Name="HyperBar" Style="{StaticResource ScoreBar}" Foreground="#0050FF"/>

                            <DockPanel>
                                <Ellipse Style="{StaticResource ScoreDot}" Fill="#FFBE00"/>
                                <TextBlock x:Name="EczemaScoreTxt" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource ScoreValue}"/>
                                <TextBlock Text="Eczema" Style="{StaticResource ScoreName}"/>
                            </DockPanel>
                            <ProgressBar x:Name="EczemaBar" Style="{StaticResource ScoreBar}" Foreground="#FFBE00"/>

                            <DockPanel>
                                <Ellipse Style="{StaticResource ScoreDot}" Fill="#00C83C"/>
                                <TextBlock x:Name="NormalScoreTxt" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource ScoreValue}"/>
                                <TextBlock Text="Normal" Style="{StaticResource ScoreName}"/>
                            </DockPanel>
                            <ProgressBar x:Name="NormalBar" Style="{StaticResource ScoreBar}" Foreground="#00C83C" Margin="0,6,0,16"/>
                        </StackPanel>

                        <!-- Primary Result Callout -->
                        <Border Background="#F6F3EA" BorderBrush="#DCD4C1" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,0,10">
                            <DockPanel>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#E7E8CF" Margin="0,0,12,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Pulse}" Foreground="#5F6048" Width="18" Height="18" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="VerdictTxt" Text="Status: Awaiting camera / image" FontSize="14" FontWeight="SemiBold" Foreground="#2F3024" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="RegionTxt" Text="" FontSize="12" FontStyle="Italic" Foreground="#5A5A45" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="DisclaimerTxt"
                                   Text="Screening aid only. Not a medical diagnosis. Heatmaps show regions that influenced the model, not lesion outlines. Results are pending review."
                                   FontSize="11" Foreground="#6F6F58" TextWrapping="Wrap" Margin="2,0,0,14"/>

                        <Expander x:Name="MoreOptions" FontSize="14" FontWeight="SemiBold" Foreground="#2F3024" Margin="0,0,0,14">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Sliders}" Foreground="#6F6F58" Width="18" Height="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="More options" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="4,12,4,0">
                        <!-- Which heatmap is drawn on the image (researcher CAM target class) -->
                        <!-- hidden: the heat map always shows the predicted category ("Predicted" stays selected) -->
                        <StackPanel x:Name="HeatmapChoicePanel" Visibility="Collapsed">
                        <TextBlock Text="Heat-map category" FontSize="12" FontWeight="SemiBold" Foreground="#2F3024" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,14">
                            <RadioButton x:Name="ViewPredictedRb" GroupName="OverlayView" Content="Predicted" IsChecked="True" Margin="0,0,8,6" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewAllRb" GroupName="OverlayView" Content="All classes" Margin="0,0,8,6" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewAcneRb" GroupName="OverlayView" Content="Acne" Foreground="#CC0000" Margin="0,0,8,6" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewHyperRb" GroupName="OverlayView" Content="Hyperpigmentation" Foreground="#0040CC" Margin="0,0,8,6" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewEczemaRb" GroupName="OverlayView" Content="Eczema" Foreground="#B38600" Margin="0,0,8,6" FontSize="12" Checked="OverlayViewRb_Checked"/>
                            <RadioButton x:Name="ViewNormalRb" GroupName="OverlayView" Content="Normal" Foreground="#008A28" Margin="0,0,8,6" FontSize="12" Checked="OverlayViewRb_Checked"/>
                        </WrapPanel>
                        </StackPanel>

                        <!-- Researcher view -->
                        <CheckBox x:Name="ResearcherChk" Content="Researcher view" FontSize="13" Foreground="#2F3024"
                                  Margin="0,0,0,8" Checked="ResearcherChk_Changed" Unchecked="ResearcherChk_Changed"/>

                        <Border x:Name="ResearcherPanel" Visibility="Collapsed" Style="{StaticResource Panel}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Heat-map controls" FontSize="12" FontWeight="SemiBold" Foreground="#2F3024" Margin="0,0,0,4"/>
                                <CheckBox x:Name="CamOnChk" Content="Live Grad-CAM++ ON" IsChecked="True" FontSize="12.5" Margin="0,0,0,6"
                                          Checked="CamOnChk_Changed" Unchecked="CamOnChk_Changed"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Overlay opacity" FontSize="12" Width="104" VerticalAlignment="Center" Foreground="#2F3024"/>
                                    <TextBlock x:Name="OpacityTxt" DockPanel.Dock="Right" Width="40" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Foreground="#2F3024"/>
                                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="ResearcherMetricsTxt" Text="" FontFamily="Consolas" FontSize="11" Foreground="#2D2E22" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="OpenDetailsBtn" Content="Capture details / review" Style="{StaticResource SmallButton}" Margin="0,0,8,8"
                                            IsEnabled="False" Click="OpenDetailsBtn_Click"/>
                                    <Button x:Name="GalleryBtn" Content="Comparison gallery" Style="{StaticResource SmallButton}" Margin="0,0,8,8"
                                            IsEnabled="False" Click="GalleryBtn_Click"/>
                                    <Button x:Name="PendingBtn" Content="Pending reviews" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="PendingBtn_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                            </StackPanel>
                        </Expander>

                        <!-- Results / report (enabled once the scan is saved) -->
                        <Button x:Name="ViewResultsBtn" Style="{StaticResource PrimaryButton}" Height="58"
                                IsEnabled="False" Margin="0,0,0,10" Click="ViewResultsBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View results" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ChevronRight}" Width="19" Height="19" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PrintBtn" Style="{StaticResource AccentButton}" Height="54" FontWeight="Bold"
                                IsEnabled="False" Click="PrintBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Report}" Width="19" Height="19" Margin="0,0,10,0"/>
                                <TextBlock Text="Create report" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
