<Application x:Class="SkinDevApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkinDevApp"
>
    <!-- The LUMYVUE design system lives in Themes/:
           Lumyvue.Tokens.xaml    colours, gradients, fonts
           Lumyvue.Icons.xaml     vector line icons
           Lumyvue.Controls.xaml  every shared style (merges the two above)
         The app starts with the splash screen (App.xaml.cs), which opens the main window when the system is ready. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SkinDevApp;component/Themes/Lumyvue.Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
