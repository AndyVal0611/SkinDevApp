<Page x:Class="SkinDevApp.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Background="#FBF9F6" Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="BigAction" TargetType="Button">
            <Setter Property="Background" Value="#1A2328"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTile" TargetType="Button" BasedOn="{StaticResource BigAction}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2328"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,25,25,25">
            <ContentControl x:Name="HeaderHost"/>

            <Grid Margin="8,0,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="WelcomeTxt" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Re-check system" Style="{StaticResource SmallButton}" VerticalAlignment="Bottom"
                        Click="RecheckBtn_Click"/>
            </Grid>

            <!-- System readiness -->
            <ContentControl x:Name="HealthHost" Margin="8,8,8,4"/>

            <!-- Participant the workflow is currently on -->
            <Border x:Name="CurrentParticipantBox" Style="{StaticResource NoticeBox}" Margin="8,4,8,4" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SmallButton}" Click="ClearParticipantBtn_Click"/>
                    <TextBlock x:Name="CurrentParticipantTxt" FontSize="13" Foreground="#1A2328" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Primary actions -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="NewRegistrationBtn" Style="{StaticResource BigAction}" Click="NewRegistrationBtn_Click">
                    <StackPanel>
                        <TextBlock Text="NEW REGISTRATION" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Register a participant. A PatientID is generated automatically, then consent is recorded."
                                   FontSize="13" Foreground="#E0B0A2" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SkinAnalysisBtn" Grid.Column="1" Style="{StaticResource BigAction}" Background="#3A4A40" Click="SkinAnalysisBtn_Click">
                    <StackPanel>
                        <TextBlock Text="SKIN ANALYSIS" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Select an existing participant (or continue with the current one) and run the Front / Left / Right scan."
                                   FontSize="13" Foreground="#E2EADF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Secondary navigation -->
            <TextBlock Text="More" Style="{StaticResource H2}" Margin="8,14,8,4"/>
            <UniformGrid x:Name="NavGrid" Columns="3"/>

            <TextBlock Style="{StaticResource Muted}" Margin="8,14,8,0" FontSize="11"
                       Text="PrecisionSkin is a research prototype intended to assist with automated skin-image classification. It does not replace professional medical evaluation."/>
        </StackPanel>
    </ScrollViewer>
</Page>
