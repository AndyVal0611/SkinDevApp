<Page x:Class="SkinDevApp.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Background="Transparent" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="BigAction" TargetType="Button">
            <Setter Property="Background" Value="#6E6F52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="168"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="30,0,26,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.93" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideNavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTile" TargetType="Button" BasedOn="{StaticResource BigAction}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3A3B2C"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side navigation -->
        <Border x:Name="Sidebar" Width="244" Margin="25,25,0,25" CornerRadius="26" Background="{StaticResource HeroSage}" Padding="12,20,12,16" VerticalAlignment="Stretch">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,16">
                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="#DDDCC2"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="OldLogBtn" Style="{StaticResource SideNavBtn}" Visibility="Collapsed" Click="OldLogBtn_Click">
                        <TextBlock Text="Old report log (read only)" FontSize="12.5" Foreground="#DDDCC2"/>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="SideNav"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,25,25,25">
                <ContentControl x:Name="HeaderHost"/>

                <!-- Welcome banner -->
                <Border Margin="8,6,8,10" CornerRadius="24" Background="{StaticResource HeroSage}" Padding="28,22,24,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border HorizontalAlignment="Left" Background="#26FFFFFF" CornerRadius="12" Padding="12,5,14,5" Margin="0,0,0,10">
                                <TextBlock x:Name="DateTxt" FontSize="12" FontWeight="SemiBold" Foreground="#F7F5E9" Text=""/>
                            </Border>
                            <TextBlock x:Name="GreetingTxt" Text="Dashboard" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="34" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="WelcomeTxt" FontSize="14" Foreground="#EDEBD3" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="46" Margin="16,0,0,0" VerticalAlignment="Bottom" Click="RecheckBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Refresh}" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="Check system again" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- System readiness -->
                <ContentControl x:Name="HealthHost" Margin="8,2,8,6"/>

                <!-- Primary actions -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NewRegistrationBtn" Style="{StaticResource BigAction}" Height="156" Background="{StaticResource HeroSage}" Click="NewRegistrationBtn_Click">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ChevronRight}" Foreground="#F7F5E9" Width="32" Height="32" Margin="14,0,0,0"/>
                            <Border DockPanel.Dock="Left" Width="78" Height="78" CornerRadius="39" Background="#2EFFFFFF" Margin="0,0,26,0" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.UserPlus}" Foreground="White" Width="38" Height="38" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="New registration" FontSize="36" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" Foreground="White"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button x:Name="SkinAnalysisBtn" Grid.Column="1" Style="{StaticResource BigAction}" Height="156" Background="{StaticResource HeroBlush}" Click="SkinAnalysisBtn_Click">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ChevronRight}" Foreground="#FFF8F4" Width="32" Height="32" Margin="14,0,0,0"/>
                            <Border DockPanel.Dock="Left" Width="78" Height="78" CornerRadius="39" Background="#2EFFFFFF" Margin="0,0,26,0" VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ScanFace}" Foreground="White" Width="38" Height="38" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Skin analysis" FontSize="36" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" Foreground="White"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </Grid>

                <!-- Profiles: you, the current patient, the dermatologist (kept apart and labelled) -->
                <UniformGrid x:Name="StatsGrid" Columns="4" Margin="0,8,0,0"/>
                <UniformGrid x:Name="CardsGrid" Columns="3" Margin="0,0,0,0"/>
                <ContentControl x:Name="RecentHost"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
