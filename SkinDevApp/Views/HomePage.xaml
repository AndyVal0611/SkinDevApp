<Page x:Class="SkinDevApp.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard" Background="Transparent" Loaded="Page_Loaded" SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="BigAction" TargetType="Button">
            <Setter Property="Background" Value="#6E6F52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="168"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="30,0,26,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="0.93" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.985" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.985" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTile" TargetType="Button" BasedOn="{StaticResource BigAction}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3A3B2C"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,25,25,25">
            <ContentControl x:Name="HeaderHost"/>

            <!-- greeting -->
            <Grid Margin="8,4,8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DateTxt" Style="{StaticResource Eyebrow}" Text=""/>
                    <TextBlock x:Name="GreetingTxt" Text="Dashboard" Style="{StaticResource H1}" FontSize="34"/>
                    <TextBlock x:Name="WelcomeTxt" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="46" Margin="0" VerticalAlignment="Bottom" Click="RecheckBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Refresh}" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Check system again" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- System readiness -->
            <ContentControl x:Name="HealthHost" Margin="8,4,8,2"/>

            <!-- Participant the workflow is currently on -->
            <Border x:Name="CurrentParticipantBox" Style="{StaticResource NoticeBox}" Margin="8,2,8,4" Padding="12,10,12,10" CornerRadius="18" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}" Height="42" Margin="0" Click="ClearParticipantBtn_Click"/>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#DDBAAE" Margin="0,0,12,0" DockPanel.Dock="Left">
                        <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.User}" Foreground="#2F3024" Width="19" Height="19" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="CurrentParticipantTxt" FontSize="13.5" Foreground="#2F3024" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Primary actions -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="NewRegistrationBtn" Style="{StaticResource BigAction}" Background="{StaticResource HeroSage}" Click="NewRegistrationBtn_Click">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ChevronRight}" Foreground="#F7F5E9" Width="26" Height="26" Margin="16,0,0,0"/>
                        <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32" Background="#26FFFFFF" Margin="0,0,20,0" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.UserPlus}" Foreground="White" Width="30" Height="30" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="New registration" FontSize="28" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" Foreground="White"/>
                            <TextBlock Text="Register a patient. A Patient ID is created automatically, then consent is recorded."
                                       FontSize="13.5" Foreground="#EDEBD3" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button x:Name="SkinAnalysisBtn" Grid.Column="1" Style="{StaticResource BigAction}" Background="{StaticResource HeroBlush}" Click="SkinAnalysisBtn_Click">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ChevronRight}" Foreground="#FFF8F4" Width="26" Height="26" Margin="16,0,0,0"/>
                        <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32" Background="#2EFFFFFF" Margin="0,0,20,0" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.ScanFace}" Foreground="White" Width="30" Height="30" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Skin analysis" FontSize="28" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" Foreground="White"/>
                            <TextBlock Text="Choose a patient (or continue with the current one) and take the front, left and right photographs."
                                       FontSize="13.5" Foreground="#FFF1EB" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </Grid>

            <!-- Secondary navigation -->
            <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="10,18,8,6"/>
            <UniformGrid x:Name="NavGrid" Columns="3"/>

            <DockPanel Margin="10,16,8,0">
                <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Info}" Foreground="#8D8D76" Width="15" Height="15" Margin="0,0,8,0"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"
                           Text="LUMYVUE is a research prototype that assists with automated skin-image classification. It does not replace professional medical evaluation."/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
