<Page x:Class="SkinDevApp.Views.ModelInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Model Information" Background="#FBF9F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <ContentControl x:Name="HeaderHost"/>
            <StackPanel Margin="8,0,8,8">
                <TextBlock Text="Model Information" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                           Text="Exactly which model produces results. Every saved scan stores the model version and hashes shown here."/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LeftColumn"/>
                <StackPanel x:Name="RightColumn" Grid.Column="1"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
