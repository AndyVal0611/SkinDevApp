<Page x:Class="SkinDevApp.Views.ModelInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Model information" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <ContentControl x:Name="HeaderHost"/>
            <StackPanel Margin="8,0,8,8">
                <TextBlock Text="Model information" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                           Text="Every model LUMYVUE uses during a scan, and whether each one is ready."/>
            </StackPanel>
            <Grid x:Name="SplitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LeftColumn"/>
                <StackPanel x:Name="RightColumn" Grid.Column="1"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
