<Window x:Class="SkinDevApp.ResearcherVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Researcher Verification" Height="820" Width="1250" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource BodyFont}" Background="#F6F3EA">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderGradient}" CornerRadius="18" Padding="22,14" Margin="8,0,8,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LUMYVUE" Foreground="White" FontSize="24" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic"/>
                    <ContentControl Style="{StaticResource SkinRibbon}" Margin="2,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Height="34" Background="#40FFFFFF" Margin="18,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTxt" Text="Researcher Verification" Foreground="#F7F5E9" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleTxt" Foreground="#DDDCC2" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- AI prediction (read-only) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AiColumn"/>
            </ScrollViewer>

            <!-- Human assessments -->
            <TabControl Grid.Column="1" Margin="8" Background="#FFFEFB" BorderBrush="#E8E2D3" BorderThickness="1" Padding="4">
                <TabItem Header="  Researcher assessment  " FontSize="13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResearcherForm" Margin="16"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="  Dermatologist validation  " FontSize="13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DermForm" Margin="16"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="  History  " FontSize="13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryPanel" Margin="16"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <DockPanel Grid.Row="2" Margin="8,10,8,0">
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Width="130" DockPanel.Dock="Right" Click="CloseBtn_Click"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11.5"
                       Text="The computer's result, the researcher's assessment and the dermatologist's validation are saved as three separate records. Saving an assessment never changes the computer's result; each save adds a new record."/>
        </DockPanel>
    </Grid>
</Window>