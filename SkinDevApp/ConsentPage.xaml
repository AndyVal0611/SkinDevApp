<Page x:Class="SkinDevApp.ConsentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Consent" Background="Transparent">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <StackPanel Grid.Row="1" Margin="8,0,8,8">
            <TextBlock Text="Consent" Style="{StaticResource H1}"/>
            <TextBlock x:Name="ParticipantTxt" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Background="#F7F5EC" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="8">
                    <TextBlock x:Name="PreviousConsentTxt" Style="{StaticResource Body}" FontSize="12"
                               Text="Items marked * are required. Nothing is ticked for you. Your answer and the time are saved in the patient record."/>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A. Agreement to use LUMYVUE" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                                   Text="LUMYVUE is an AI-assisted facial skin health monitoring system. It captures images of the face and analyzes them using artificial intelligence. It does not provide a diagnosis and does not replace professional medical evaluation. Giving consent is voluntary, and you may stop at any time without any consequences."/>
                        <CheckBox x:Name="UnderstoodChk" Margin="0,4" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I have read (or had read to me) and understood the information above, and my questions were answered. *"/>
                        </CheckBox>
                        <CheckBox x:Name="VoluntaryChk" Margin="0,4" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I understand that giving consent is voluntary and that I may withdraw it at any time. *"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="B. Agreement to capture images of the face" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                                   Text="Three images (front, left side and right side) will be taken with the LUMYVUE camera. The images are saved under your Patient ID, not your name."/>
                        <CheckBox x:Name="CaptureChk" Margin="0,4" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I give permission for images of my face to be taken. *"/>
                        </CheckBox>
                        <CheckBox x:Name="ProcessingChk" Margin="0,4" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I give permission for these images to be analyzed by the LUMYVUE system. *"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="White" CornerRadius="14" Padding="16,12" Margin="8,10,8,0">
            <DockPanel>
                <Button Content="Decline" Style="{StaticResource SecondaryButton}" Width="130" Click="DeclineBtn_Click"/>
                <Button x:Name="AgreeBtn" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Agree and continue  ›"
                        Style="{StaticResource PrimaryButton}" Width="220" IsEnabled="False" Click="AgreeBtn_Click"/>
                <TextBlock x:Name="HintTxt" Foreground="#6F6F58" FontSize="12" VerticalAlignment="Center" Margin="14,0"
                           Text="Tick every required item to continue."/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
