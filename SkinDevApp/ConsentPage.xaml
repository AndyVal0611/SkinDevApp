<Page x:Class="SkinDevApp.ConsentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Consent" Background="Transparent">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <StackPanel Grid.Row="1" Margin="8,0,8,8">
            <TextBlock Text="Patient Consent Form" Style="{StaticResource H1}"/>
            <TextBlock x:Name="ParticipantTxt" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Background="#F7F5EC" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="8">
                    <TextBlock x:Name="PreviousConsentTxt" Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap"
                               Text="Items marked with an asterisk (*) are required. No options are selected by default. Your responses and the date and time of consent will be recorded in your patient record."/>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="A. Consent to Use LUMYVUE" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="LUMYVUE is an AI-assisted facial skin health monitoring system that captures facial images and analyzes them using artificial intelligence. The system is intended to assist in monitoring visible skin conditions and does not provide a medical diagnosis or replace professional medical evaluation."/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="Your participation is entirely voluntary. You may withdraw your consent at any time without penalty or adverse consequences."/>
                        <TextBlock Text="Please confirm the following:" FontSize="13" FontWeight="SemiBold" Foreground="#2F3024" Margin="0,0,0,4"/>
                        <CheckBox x:Name="UnderstoodChk" Margin="0,5" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I have read and understood the information provided above, or it has been explained to me. I have also had the opportunity to ask questions and have received satisfactory answers.&#160;*"/>
                        </CheckBox>
                        <CheckBox x:Name="VoluntaryChk" Margin="0,5" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I understand that my participation is voluntary and that I may withdraw my consent at any time without penalty or adverse consequences.&#160;*"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="B. Consent to Facial Image Capture and Analysis" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="LUMYVUE will capture three facial images: one front-facing image and two side-profile images (left and right). These images will be stored and associated with your assigned Patient ID rather than your name."/>
                        <TextBlock Text="Please confirm the following:" FontSize="13" FontWeight="SemiBold" Foreground="#2F3024" Margin="0,0,0,4"/>
                        <CheckBox x:Name="CaptureChk" Margin="0,5" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I voluntarily authorize the capture of three images of my face using the LUMYVUE camera.&#160;*"/>
                        </CheckBox>
                        <CheckBox x:Name="ProcessingChk" Margin="0,5" Checked="Check_Changed" Unchecked="Check_Changed">
                            <TextBlock TextWrapping="Wrap" FontSize="13" Text="I authorize the use of these facial images for analysis by the LUMYVUE system to identify and assess visible skin conditions.&#160;*"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="White" CornerRadius="14" Padding="16,12" Margin="8,10,8,0">
            <DockPanel>
                <Button Content="Decline" Style="{StaticResource SecondaryButton}" Width="130" Click="DeclineBtn_Click"/>
                <Button x:Name="AgreeBtn" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Agree and continue  ›"
                        Style="{StaticResource PrimaryButton}" Width="220" IsEnabled="False" Click="AgreeBtn_Click"/>
                <TextBlock x:Name="HintTxt" Foreground="#6F6F58" FontSize="12" VerticalAlignment="Center" Margin="14,0"
                           Text="Tick every required item to continue."/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
