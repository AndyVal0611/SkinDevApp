<Window x:Class="SkinDevApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMYVUE" Height="850" Width="1250"
        MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3EA"
        FontFamily="{StaticResource BodyFont}">
    <Grid x:Name="Root" Background="{StaticResource PageWash}">
        <!-- The whole interface is scaled to the screen: on a 1920 x 1080 monitor it is shown a little larger, so text and touch
             targets keep a comfortable size; on smaller or high-DPI screens it stays at 100 %. -->
        <Grid x:Name="ScaleHost">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
            <!-- Frame container na humahawak sa mga pages -->
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- dims the screen behind LUMYVUE dialogs -->
        <Border x:Name="DimLayer" Background="#662F3024" Visibility="Collapsed" Opacity="0"/>

        <!-- shown while LUMYVUE closes (and while the last scan is still being saved) -->
        <Border x:Name="ExitLayer" Background="{StaticResource SplashWash}" Visibility="Collapsed" Opacity="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="LUMYVUE" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="54" Foreground="White" HorizontalAlignment="Center"/>
                <ContentControl Style="{StaticResource SkinRibbon}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="ExitTxt" Text="Closing LUMYVUE" FontSize="14" Foreground="#DDDCC2" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </Border>

        <!-- short notifications slide in at the bottom right -->
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" IsHitTestVisible="False"/>
    </Grid>
</Window>
