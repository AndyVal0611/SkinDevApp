<Window x:Class="SkinDevApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMYVUE - AI Skin Health Monitoring" Height="850" Width="1250"
        MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEF0DD" Offset="0"/>
                <GradientStop Color="#F6F3EA" Offset="0.55"/>
                <GradientStop Color="#F7E9E3" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <!-- Frame container na humahawak sa mga pages -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>