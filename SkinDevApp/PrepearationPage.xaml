<Page x:Class="SkinDevApp.PreparationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SkinDevApp"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1100"
      Title="Preparation"
      Background="#FBF9F6"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="PrepCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.04" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A2328"/>
        </Style>
        <Style x:Key="CardBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="ConfirmLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1A2328"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="8,0,8,18">
            <TextBlock Text="Pre-Analysis Preparation" FontSize="26" FontWeight="Bold" Foreground="#1A2328"/>
            <TextBlock Text="Complete each step below before starting your skin health scan."
                       FontSize="14" Foreground="#8A827A" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1A2328" CornerRadius="14" Padding="18,14" Margin="8,0,8,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="OverallStatusDot" Width="14" Height="14" Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="OverallStatusTitle" Text="Preparation in progress" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="OverallStatusDetail" Text="0 of 4 checks complete" FontSize="12" Foreground="#E0B0A2" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Re-check camera" Height="36" Padding="14,0"
                        Background="#E0B0A2" Foreground="#1A2328" FontWeight="SemiBold" FontSize="12"
                        BorderThickness="0" VerticalAlignment="Center" Click="RecheckCameraBtn_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2" Margin="0,0,0,8">

                <Border Style="{StaticResource PrepCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="📷" FontSize="22" Margin="0,0,10,0"/>
                                <TextBlock Text="Camera connection" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="CameraStatusDot" Width="10" Height="10" Fill="#9CA3AF" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CameraStatusText" Text="Checking..." FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource CardBody}"
                                   Text="Ensure your webcam is connected and not in use by another application."/>
                        <TextBlock Grid.Row="2" x:Name="CameraDetailText" Style="{StaticResource CardBody}" Margin="0,8,0,0"
                                   Text="Scanning for video input devices..."/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PrepCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="💡" FontSize="22" Margin="0,0,10,0"/>
                                <TextBlock Text="Lighting check" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="LightingStatusDot" Width="10" Height="10" Fill="#9CA3AF" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LightingStatusText" Text="Pending" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource CardBody}"
                                   Text="Use even, front-facing light. Avoid strong backlighting or harsh shadows on the face."/>
                        <Button Grid.Row="2" x:Name="LightingConfirmBtn" Style="{StaticResource ConfirmLinkButton}"
                                Content="Confirm lighting looks good"
                                Click="LightingConfirmBtn_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PrepCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="📏" FontSize="22" Margin="0,0,10,0"/>
                                <TextBlock Text="Distance" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="DistanceStatusDot" Width="10" Height="10" Fill="#9CA3AF" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DistanceStatusText" Text="Pending" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource CardBody}"
                                   Text="Sit about an arm&apos;s length (40-60 cm) from the camera so your full face fits comfortably in frame."/>
                        <Button Grid.Row="2" x:Name="DistanceConfirmBtn" Style="{StaticResource ConfirmLinkButton}"
                                Content="Confirm distance is correct"
                                Click="DistanceConfirmBtn_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PrepCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="🙂" FontSize="22" Margin="0,0,10,0"/>
                                <TextBlock Text="Facial position" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="FaceStatusDot" Width="10" Height="10" Fill="#9CA3AF" Margin="0,0,8,0"/>
                                <TextBlock x:Name="FaceStatusText" Text="Pending" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource CardBody}"
                                   Text="Face the camera directly, keep a neutral expression, remove glasses if possible, and pull hair away from the forehead and cheeks."/>
                        <Button Grid.Row="2" x:Name="FaceConfirmBtn" Style="{StaticResource ConfirmLinkButton}"
                                Content="Confirm position is ready"
                                Click="FaceConfirmBtn_Click"/>
                    </Grid>
                </Border>

            </UniformGrid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="8,20,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="BackBtn" Content="Back" Width="120" Height="46"
                    Background="White" Foreground="#1A2328" FontWeight="SemiBold" FontSize="13"
                    BorderBrush="#E0B0A2" BorderThickness="1" Click="BackBtn_Click"/>
            <Button Grid.Column="3" x:Name="NextBtn" Content="Next" Width="140" Height="46"
                    Background="#1A2328" Foreground="White" FontWeight="Bold" FontSize="13"
                    BorderThickness="0" IsEnabled="False" Click="NextBtn_Click"/>
        </Grid>
    </Grid>
</Page>