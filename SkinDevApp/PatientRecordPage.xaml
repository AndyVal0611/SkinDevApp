<Page x:Class="SkinDevApp.PatientRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Participant Records" Background="#FBF9F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <!-- PatientID search -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12">
            <DockPanel>
                <TextBlock Text="Patient / Participant ID" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="SearchBtn" DockPanel.Dock="Right" Content="SEARCH" Style="{StaticResource PrimaryButton}" Height="38" Width="120"
                        Margin="10,0,0,0" Click="SearchBtn_Click"/>
                <TextBox x:Name="IdSearchTxt" Style="{StaticResource Field}" Height="38" FontSize="14" KeyDown="IdSearchTxt_KeyDown"
                         ToolTip="Example: PS-0001"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: browse / filter -->
            <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Browse participants" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                        <TextBox x:Name="FilterTxt" Style="{StaticResource Field}" ToolTip="ID or name" TextChanged="Filter_Changed"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="FilterDate" Height="34" ToolTip="Registration date" SelectedDateChanged="Filter_Changed"/>
                            <ComboBox x:Name="FilterStatus" Grid.Column="2" Height="34" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Withdrawn"/>
                                <ComboBoxItem Content="Completed"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="ListCountTxt" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,4"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="Scans pending verification" Style="{StaticResource SmallButton}" Margin="0,0,0,6" Click="PendingBtn_Click"/>
                        <Button Content="Unlinked / legacy scans" Style="{StaticResource SmallButton}" Margin="0,0,0,6" Click="UnlinkedBtn_Click"/>
                        <Button Content="Import saved scans from disk" Style="{StaticResource SmallButton}" Margin="0,0,0,6" Click="ImportBtn_Click"
                                ToolTip="Index older scan folders (session.json / record.json) that are not in the database yet"/>
                        <Button Content="Register new participant" Style="{StaticResource SmallButton}" Click="RegisterBtn_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ParticipantList" BorderThickness="0" SelectionChanged="ParticipantList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- Right: record -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" x:Name="RecordScroll">
                <StackPanel x:Name="RecordPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
