<Page x:Class="SkinDevApp.PatientRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patient records" Background="Transparent">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost"/>

        <!-- PatientID search -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12">
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="20" Background="#E7E8CF" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Search}" Foreground="#5F6048" Width="19" Height="19" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Search by patient ID or name" FontWeight="SemiBold" FontSize="14" Foreground="#2F3024" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="SearchBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="46" Width="140"
                        Margin="12,0,0,0" Click="SearchBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Search}" Width="17" Height="17" Margin="0,0,8,0"/>
                        <TextBlock Text="Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="IdSearchTxt" Style="{StaticResource Field}" Height="46" FontSize="14" KeyDown="IdSearchTxt_KeyDown"
                         ToolTip="Patient ID (PS-0001 or 0001) or a name (Elaiza, Bautista). Partial text works."/>
            </DockPanel>
        </Border>

        <Grid x:Name="SplitGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: browse / filter -->
            <Border x:Name="SidebarCard" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Browse patients" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                        <TextBlock Text="Filter by ID or name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FilterTxt" Style="{StaticResource Field}" ToolTip="ID or name" TextChanged="Filter_Changed"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="FilterDate" Height="34" ToolTip="Registration date" SelectedDateChanged="Filter_Changed"/>
                            <ComboBox x:Name="FilterStatus" Grid.Column="2" Height="34" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Withdrawn"/>
                                <ComboBoxItem Content="Completed"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="ListCountTxt" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,4"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Style="{StaticResource GhostButton}" Height="46" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="PendingBtn_Click"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Clock}" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="Scans waiting for review" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource GhostButton}" Height="46" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="UnlinkedBtn_Click"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Folder}" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="Scans without a patient" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource GhostButton}" Height="46" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="ImportBtn_Click" ToolTip="Adds older scan folders that are not in the database yet"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.Search}" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="Find saved scans" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource PrimaryButton}" Height="46" Margin="0,0,0,6" HorizontalContentAlignment="Left" Click="RegisterBtn_Click"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource IconBox}" Tag="{StaticResource Icon.UserPlus}" Width="17" Height="17" Margin="0,0,10,0"/><TextBlock Text="Register new patient" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                    <ListBox x:Name="ParticipantList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch" SelectionChanged="ParticipantList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- Right: record -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" x:Name="RecordScroll">
                <StackPanel x:Name="RecordPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>