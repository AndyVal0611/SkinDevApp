<Page x:Class="SkinDevApp.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings" Background="#FBF9F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ContentControl x:Name="HeaderHost"/>
        <StackPanel Grid.Row="1" Margin="8,0,8,8">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                       Text="Researcher / admin only. These values change how scans are captured and analysed, so every change is written to the audit log with a timestamp and the current model version. They apply from the next scan."/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="LeftColumn"/>
                <StackPanel x:Name="RightColumn" Grid.Column="1"/>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="3" Background="White" CornerRadius="14" Padding="16,12" Margin="8,10,8,0">
            <DockPanel>
                <Button Content="Restore defaults" Style="{StaticResource SecondaryButton}" Width="170" Click="DefaultsBtn_Click"/>
                <Button x:Name="SaveBtn" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Save settings" Style="{StaticResource PrimaryButton}"
                        Width="180" Click="SaveBtn_Click"/>
                <TextBlock x:Name="StatusTxt" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
