<Page x:Class="SkinDevApp.ResearchDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Research Dashboard" Background="#FBF9F6">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <ContentControl x:Name="HeaderHost"/>
            <DockPanel Margin="8,0,8,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SmallButton}" VerticalAlignment="Bottom" Click="RefreshBtn_Click"/>
                <StackPanel>
                    <TextBlock Text="Research Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
                               Text="Every number below is counted from the stored database at the time of loading. Nothing is estimated or hard-coded."/>
                </StackPanel>
            </DockPanel>
            <UniformGrid x:Name="StatGrid" Columns="4"/>
            <UniformGrid x:Name="ChartGrid" Columns="2"/>
        </StackPanel>
    </ScrollViewer>
</Page>
