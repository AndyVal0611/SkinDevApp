<Page x:Class="SkinDevApp.Views.LoginForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginForm" SizeChanged="Page_SizeChanged" Background="#F8F1E6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrandCol" Width="5*" MinWidth="340"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border x:Name="BrandPanel" Margin="20" CornerRadius="28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                    <GradientStop Color="#E4E9D3" Offset="0"/>
                    <GradientStop Color="#F2E7D5" Offset="0.5"/>
                    <GradientStop Color="#E9C8AC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
            <!-- soft light and warmth overlays for depth -->
            <Border CornerRadius="28" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.1,0.05" GradientOrigin="0.1,0.05" RadiusX="0.8" RadiusY="0.55">
                        <GradientStop Color="#80FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="28" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.95,1" GradientOrigin="0.95,1" RadiusX="0.85" RadiusY="0.5">
                        <GradientStop Color="#66D09F7C" Offset="0"/>
                        <GradientStop Color="#00D09F7C" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Grid Margin="46,44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="LUMYVUE" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="72" Foreground="#4F5644"/></Viewbox>
                    <TextBlock Text="AI skin health monitoring" FontSize="17" Foreground="#7A816B" Margin="4,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="30" LineHeight="38" TextWrapping="Wrap"
                               Foreground="#4F5644" MaxWidth="380" HorizontalAlignment="Left"
                               Text="Three angles, one clear picture of your skin."/>
                    <TextBlock FontSize="14" LineHeight="23" TextWrapping="Wrap" Foreground="#5B5F50" MaxWidth="380" HorizontalAlignment="Left" Margin="0,14,0,0"
                               Text="PrecisionSkin photographs the face from the front, left and right, scores each image with an AI model, and shows where the model looked."/>

                    <!-- Skin-tone ribbon: the one signature element -->
                    <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                        <Border Width="42" Height="8" CornerRadius="4" Background="#F3DFD0" BorderBrush="#E3CDB8" BorderThickness="1" Margin="0,0,5,0"/>
                        <Border Width="42" Height="8" CornerRadius="4" Background="#E9C6A8" Margin="0,0,5,0"/>
                        <Border Width="42" Height="8" CornerRadius="4" Background="#D9A97F" Margin="0,0,5,0"/>
                        <Border Width="42" Height="8" CornerRadius="4" Background="#BC8559" Margin="0,0,5,0"/>
                        <Border Width="42" Height="8" CornerRadius="4" Background="#8C5A3C" Margin="0,0,5,0"/>
                        <Border Width="42" Height="8" CornerRadius="4" Background="#5B3A29"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" FontSize="11.5" Foreground="#8A8574" TextWrapping="Wrap"
                           Text="Research prototype. It is a screening aid, not a diagnosis."/>
            </Grid>
            </Grid>
        </Border>

        <!-- Sign-in form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Margin="20,30">

                <TextBlock Text="Sign in" Style="{StaticResource H1}"/>
                <TextBlock Text="Choose how you are working today." Style="{StaticResource Muted}" FontSize="13.5" Margin="0,6,0,24"/>

                <!-- Mode Selection Dropdown -->
                <TextBlock Text="Portal mode" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="PortalModeCombo" Style="{StaticResource Combo}" Height="44"
                          SelectionChanged="PortalModeCombo_SelectionChanged" Margin="0,0,0,10">
                    <ComboBoxItem Content="Operator / Kiosk (registration, consent, scanning)"/>
                    <ComboBoxItem Content="Researcher / Admin (records, verification, settings)" IsSelected="True"/>
                </ComboBox>

                <!-- Panel 1: Admin Specialist Login Fields -->
                <StackPanel x:Name="AdminCredentialsPanel">
                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                    <TextBox x:Name="UsernameTxt" Style="{StaticResource Field}" Height="44"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="PasswordTxt" Style="{StaticResource FieldPassword}" Height="44"/>

                    <!-- First run only: no researcher account exists yet -->
                    <StackPanel x:Name="FirstRunPanel" Visibility="Collapsed">
                        <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="ConfirmPasswordTxt" Style="{StaticResource FieldPassword}" Height="44"/>
                    </StackPanel>

                    <TextBlock x:Name="LoginHintTxt" FontSize="12" Foreground="#6B6658" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Panel 2: Operator / kiosk mode. Participants are registered on the Registration screen. -->
                <StackPanel x:Name="ClientRegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="Operator ID" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                    <TextBox x:Name="OperatorIdTxt" Style="{StaticResource Field}" Height="44"/>
                    <TextBlock Text="Participant details are entered on the Registration screen, where a PatientID is generated."
                               Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Dynamic Action Button -->
                <Button x:Name="EnterPortalBtn" Content="Sign in" Style="{StaticResource PrimaryButton}" Height="50"
                        FontSize="14" Margin="0,26,0,0" Click="EnterPortalBtn_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
