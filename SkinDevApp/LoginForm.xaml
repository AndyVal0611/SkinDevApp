<Page x:Class="SkinDevApp.Views.LoginForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginForm" Background="#FBF9F6">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="20" Padding="40,35" Width="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.05" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Title & Header -->
                <TextBlock Text="LUMYVUE" FontSize="28" FontWeight="Bold" Foreground="#1A2328" HorizontalAlignment="Center"/>
                <TextBlock Text="AESTHETIC SKIN CLINIC" FontSize="11" Foreground="#8A827A" HorizontalAlignment="Center" Margin="0,4,0,25" FontWeight="SemiBold"/>

                <!-- Mode Selection Dropdown -->
                <TextBlock Text="Select Portal Mode" FontSize="12" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,6"/>
                <ComboBox x:Name="PortalModeCombo" Height="42" FontSize="13" Padding="10,8" 
                          SelectionChanged="PortalModeCombo_SelectionChanged" Margin="0,0,0,18">
                    <ComboBoxItem Content="Operator / Kiosk (registration, consent, scanning)"/>
                    <ComboBoxItem Content="Researcher / Admin (records, verification, settings)" IsSelected="True"/>
                </ComboBox>

                <!-- Panel 1: Admin Specialist Login Fields -->
                <StackPanel x:Name="AdminCredentialsPanel">
                    <TextBlock Text="Username" FontSize="12" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameTxt" Text="lumyvue_eaf" Height="42" FontSize="13" VerticalContentAlignment="Center" 
                             Padding="10,0" BorderBrush="#E0B0A2" BorderThickness="1" Background="#FFFBFB" Margin="0,0,0,16"/>

                    <TextBlock Text="Password" FontSize="12" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordTxt" Height="42" FontSize="13" VerticalContentAlignment="Center" 
                                 Padding="10,0" BorderBrush="#E0B0A2" BorderThickness="1" Background="#FFFBFB" Margin="0,0,0,22"/>
                </StackPanel>

                <!-- Panel 2: Operator / kiosk mode. Participants are registered on the Registration screen. -->
                <StackPanel x:Name="ClientRegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="Operator ID" FontSize="12" FontWeight="Bold" Foreground="#1A2328" Margin="0,0,0,6"/>
                    <TextBox x:Name="OperatorIdTxt" Height="42" FontSize="13" VerticalContentAlignment="Center"
                             Padding="10,0" BorderBrush="#E0B0A2" BorderThickness="1" Background="#FFFBFB" Margin="0,0,0,8"/>
                    <TextBlock Text="Participant details are entered on the Registration screen, where a PatientID is generated."
                               FontSize="11" Foreground="#8A827A" TextWrapping="Wrap" Margin="0,0,0,18"/>
                </StackPanel>

                <!-- Dynamic Action Button -->
                <Button x:Name="EnterPortalBtn" Content="ENTER CLINIC PORTAL" Height="48" Background="#1A2328" Foreground="White" 
                        FontWeight="Bold" FontSize="12" BorderThickness="0" Click="EnterPortalBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>